+/**
+ * 颜色自定义页：气泡/背景/输入框/主色调/正文文字色 + 气泡圆角 + 两个透明度。
+ *
+ * 所有颜色都是可选项，`null` 表示「跟随主题」；圆角 `-1`、透明度 `1f` 同样是默认值。
+ */
+@Composable
+fun SettingPreferencesColorsPage(vm: SettingVM = koinViewModel()) {
+    val settings by vm.settings.collectAsStateWithLifecycle()
+    var displaySetting by remember(settings) { mutableStateOf(settings.displaySetting) }
+    var colorTarget by remember { mutableStateOf<ColorField?>(null) }
+
+    fun updateDisplaySetting(setting: DisplaySetting) {
+        displaySetting = setting
+        vm.updateSettings(settings.copy(displaySetting = setting))
+    }
+
+    val scrollBehavior = TopAppBarDefaults.exitUntilCollapsedScrollBehavior()
+
+    val colorFields = listOf(
+        ColorField(
+            title = "用户气泡颜色",
+            value = displaySetting.userBubbleColor,
+            preview = MaterialTheme.colorScheme.primaryContainer,
+            onUpdate = { updateDisplaySetting(displaySetting.copy(userBubbleColor = it)) },
+        ),
+        ColorField(
+            title = "AI 气泡颜色",
+            value = displaySetting.assistantBubbleColor,
+            preview = MaterialTheme.colorScheme.surfaceContainerHigh,
+            onUpdate = { updateDisplaySetting(displaySetting.copy(assistantBubbleColor = it)) },
+        ),
+        ColorField(
+            title = "聊天背景色",
+            value = displaySetting.chatBackgroundColor,
+            preview = MaterialTheme.colorScheme.background,
+            onUpdate = { updateDisplaySetting(displaySetting.copy(chatBackgroundColor = it)) },
+        ),
+        ColorField(
+            title = "输入框背景色",
+            value = displaySetting.inputBackgroundColor,
+            preview = MaterialTheme.colorScheme.surfaceContainerLow,
+            onUpdate = { updateDisplaySetting(displaySetting.copy(inputBackgroundColor = it)) },
+        ),
+        ColorField(
+            title = "主色调",
+            value = displaySetting.primaryColor,
+            preview = MaterialTheme.colorScheme.primary,
+            onUpdate = { updateDisplaySetting(displaySetting.copy(primaryColor = it)) },
+        ),
+        ColorField(
+            title = "聊天正文文字色",
+            value = displaySetting.chatTextColor,
+            preview = MaterialTheme.colorScheme.onSurface,
+            onUpdate = { updateDisplaySetting(displaySetting.copy(chatTextColor = it)) },
+        ),
+    )
+
+    Scaffold(
+        topBar = {
+            LargeFlexibleTopAppBar(
+                title = { Text("颜色自定义") },
+                navigationIcon = {
+                    BackButton()
+                },
+                scrollBehavior = scrollBehavior,
+                colors = CustomColors.topBarColors
+            )
+        },
+        modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+        containerColor = CustomColors.topBarColors.containerColor
+    ) { contentPadding ->
+        LazyColumn(
+            modifier = Modifier.fillMaxSize(),
+            contentPadding = contentPadding + PaddingValues(8.dp),
+            verticalArrangement = Arrangement.spacedBy(16.dp)
+        ) {
+            item {
+                CardGroup(
+                    modifier = Modifier.padding(horizontal = 8.dp),
+                    title = { Text("颜色") },
+                ) {
+                    colorFields.forEach { field ->
+                        item(
+                            onClick = { colorTarget = field },
+                            headlineContent = { Text(field.title) },
+                            supportingContent = {
+                                Text(field.value?.toHexArgb() ?: "跟随主题")
+                            },
+                            trailingContent = {
+                                Box(
+                                    modifier = Modifier
+                                        .size(28.dp)
+                                        .clip(CircleShape)

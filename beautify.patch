+/** 模糊强度滑块的取值范围，和 DisplaySetting.materialBlurRadius 的收敛范围一致 */
+private const val MIN_MATERIAL_BLUR = 0
+private const val MAX_MATERIAL_BLUR = 40
+private const val DEFAULT_MATERIAL_BLUR = 16
+private const val DEFAULT_BUBBLE_REALTIME_BLUR = false
+private val DEFAULT_SURFACE_MATERIAL = SurfaceMaterial.SOLID
+
+/** 三选一的显示顺序与中文名 */
+private val SURFACE_MATERIAL_OPTIONS = listOf(
+    SurfaceMaterial.SOLID to "纯色",
+    SurfaceMaterial.FROSTED to "磨砂",
+    SurfaceMaterial.LIQUID to "液态",
+)
+
+/**
+ * 界面材质页：纯色 / 磨砂玻璃 / 液态玻璃 + 模糊强度 + 气泡实时模糊。
+ *
+ * 全部带默认值，默认 SOLID + 16dp + 关闭气泡模糊，和原版外观完全一致。

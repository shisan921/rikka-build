+
+/**
+ * 颜色自定义页：顶部「主题基色」+ 配色风格 + 气泡 / 背景 / 输入框 / 主色调 / 正文文字色 / 消息时间颜色共 7 个颜色。
+ *
+ * 所有颜色都是可选项，`null` 表示「跟随主题」。点任意一行都打开取色盘（色域 + 色相 + 透明度 + HEX + 记忆色），
+ * 只有点「确认」才会写回设置。透明度滑块在「透明度设置」页，气泡圆角和插图素材在「插图素材」页，
+ * 「对白样式」（引号高亮 / 底色 / 下划线）已经搬到 SettingPreferencesQuotePage。
+ */
+@Composable
+fun SettingPreferencesColorsPage(vm: SettingVM = koinViewModel()) {
+    val settings by vm.settings.collectAsStateWithLifecycle()
+    var displaySetting by remember(settings) { mutableStateOf(settings.displaySetting) }
+    // 只记「正在改哪一项」的 key，颜色值 / 更新函数每次都从当前组合里重新取，避免弹窗拿到过期的闭包
+    var colorTargetKey by remember { mutableStateOf<String?>(null) }
+    var showSchemeStyleDialog by remember { mutableStateOf(false) }
+
+    fun applyDisplaySetting(transform: (DisplaySetting) -> DisplaySetting) {
+        val next = transform(displaySetting)
+        displaySetting = next
+        vm.updateSettings(settings.copy(displaySetting = next))
+    }
+
+    fun updateDisplaySetting(setting: DisplaySetting) {
+        displaySetting = setting
+        vm.updateSettings(settings.copy(displaySetting = setting))
+    }
+
+    val scrollBehavior = TopAppBarDefaults.exitUntilCollapsedScrollBehavior()
+
+    // 主题基色：只给一个颜色，整套浅色/深色配色由它推出来，优先级比单个「主色调」低
+    val seedField = ColorField(
+        key = "seed",
+        title = "主题基色",
+        value = displaySetting.themeSeedColor,
+        preview = MaterialTheme.colorScheme.primary,
+        supporting = { value ->
+            value?.let { "基色 ${it.toHexArgb()}，整套配色按它生成" }
+                ?: "设一个颜色，自动生成整套浅色/深色配色（留空则用当前主题）"
+        },
+        apply = { setting, value -> setting.copy(themeSeedColor = value) },
+    )
+
+    val colorFields = listOf(
+        ColorField(
+            key = "userBubble",
+            title = "用户气泡颜色",
+            value = displaySetting.userBubbleColor,
+            preview = MaterialTheme.colorScheme.primaryContainer,
+            supporting = { it?.toHexArgb() ?: "跟随主题" },
+            apply = { setting, value -> setting.copy(userBubbleColor = value) },
+        ),
+        ColorField(
+            key = "assistantBubble",
+            title = "AI 气泡颜色",
+            value = displaySetting.assistantBubbleColor,
+            preview = MaterialTheme.colorScheme.surfaceContainerHigh,
+            supporting = { it?.toHexArgb() ?: "跟随主题" },
+            apply = { setting, value -> setting.copy(assistantBubbleColor = value) },
+        ),
+        ColorField(
+            key = "recallUser",
+            title = "对话回顾·我发的",
+            value = displaySetting.recallUserColor,
+            preview = MaterialTheme.colorScheme.primaryContainer,
+            supporting = { it?.toHexArgb() ?: "跟随用户气泡色" },
+            apply = { setting, value -> setting.copy(recallUserColor = value) },
+        ),
+        ColorField(
+            key = "recallAssistant",
+            title = "对话回顾·AI 发的",
+            value = displaySetting.recallAssistantColor,
+            preview = MaterialTheme.colorScheme.secondaryContainer,
+            supporting = { it?.toHexArgb() ?: "跟随 AI 气泡色" },
+            apply = { setting, value -> setting.copy(recallAssistantColor = value) },
+        ),
+        ColorField(
+            key = "chatBackground",
+            title = "聊天背景色",
+            value = displaySetting.chatBackgroundColor,
+            preview = MaterialTheme.colorScheme.background,
+            supporting = { it?.toHexArgb() ?: "跟随主题" },
+            apply = { setting, value -> setting.copy(chatBackgroundColor = value) },
+        ),
+        ColorField(
+            key = "inputBackground",
+            title = "输入框背景色",
+            value = displaySetting.inputBackgroundColor,
+            preview = MaterialTheme.colorScheme.surfaceContainerLow,
+            supporting = { it?.toHexArgb() ?: "跟随主题" },
+            apply = { setting, value -> setting.copy(inputBackgroundColor = value) },
+        ),
+        ColorField(
+            key = "primary",
+            title = "主色调",
+            value = displaySetting.primaryColor,
+            preview = MaterialTheme.colorScheme.primary,
+            supporting = { it?.toHexArgb() ?: "跟随主题" },
+            apply = { setting, value -> setting.copy(primaryColor = value) },
+        ),
+        ColorField(
+            key = "chatText",
+            title = "聊天正文文字色",
+            value = displaySetting.chatTextColor,
+            preview = MaterialTheme.colorScheme.onSurface,
+            supporting = { it?.toHexArgb() ?: "跟随主题" },
+            apply = { setting, value -> setting.copy(chatTextColor = value) },
+        ),
+        // 消息时间颜色：三级回退（自己设的颜色 → 正文文字色 → 主题 onSurface），所以副标题写「跟随正文」
+        ColorField(
+            key = "messageTime",
+            title = "消息时间颜色",
+            value = displaySetting.messageTimeColor,
+            preview = MaterialTheme.colorScheme.onSurface,
+            supporting = { it?.toHexArgb() ?: "跟随正文文字色" },
+            apply = { setting, value -> setting.copy(messageTimeColor = value) },
+        ),
+    )
+
+    Scaffold(
+        topBar = {
+            LargeFlexibleTopAppBar(
+                title = { Text("颜色自定义") },
+                navigationIcon = {
+                    BackButton()
+                },
+                scrollBehavior = scrollBehavior,
+                colors = CustomColors.topBarColors
+            )
+        },
+        modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+        containerColor = CustomColors.topBarColors.containerColor
+    ) { contentPadding ->
+        LazyColumn(
+            modifier = Modifier.fillMaxSize(),
+            contentPadding = contentPadding + PaddingValues(8.dp),
+            verticalArrangement = Arrangement.spacedBy(16.dp)
+        ) {
+            item {
+                CardGroup(
+                    modifier = Modifier.padding(horizontal = 8.dp),
+                    title = { Text("颜色") },
+                ) {
+                    item(
+                        onClick = { colorTargetKey = seedField.key },
+                        headlineContent = { Text(seedField.title) },
+                        supportingContent = {
+                            Text(seedField.supporting(seedField.value))
+                        },
+                        trailingContent = {
+                            Box(
+                                modifier = Modifier
+                                    .size(28.dp)
+                                    .clip(CircleShape)
+                                    .background(seedField.value?.let { Color(it) } ?: seedField.preview),
+                            )
+                        },
+                    )
+                    // 配色风格：只有设了主题基色才真正起作用（白/灰基色会被算法自动拉成中性灰阶）
+                    item(
+                        onClick = { showSchemeStyleDialog = true },
+                        headlineContent = { Text("配色风格") },
+                        supportingContent = {
+                            Text(themeSchemeStyleLabel(displaySetting.themeSchemeStyle))
+                        },
+                        trailingContent = {
+                            Icon(
+                                imageVector = HugeIcons.ArrowRight01,
+                                contentDescription = null,
+                                tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                            )
+                        },
+                    )
+                    colorFields.forEach { field ->
+                        item(
+                            onClick = { colorTargetKey = field.key },
+                            headlineContent = { Text(field.title) },
+                            supportingContent = {
+                                Text(field.supporting(field.value))
+                            },
+                            trailingContent = {
+                                Box(
+                                    modifier = Modifier
+                                        .size(28.dp)
+                                        .clip(CircleShape)
+                                        .background(field.value?.let { Color(it) } ?: field.preview),
+                                )
+                            },
+                        )
+                    }
+                }
+            }
+        }
+    }
+
+    val activeField = colorTargetKey?.let { key ->
+        (listOf(seedField) + colorFields).firstOrNull { it.key == key }
+    }
+    if (activeField != null) {
+        ColorPickerDialog(
+            title = activeField.title,
+            initialColor = activeField.value,
+            fallbackColor = activeField.preview,
+            recentColors = displaySetting.recentColors,
+            onRecentColorsChange = { colors ->
+                applyDisplaySetting { it.copy(recentColors = colors) }
+            },
+            onDismiss = { colorTargetKey = null },
+            // 确认：既写颜色，也把颜色收进记忆色（单次写入，避免两次 update 互相覆盖）
+            onConfirm = { color ->
+                applyDisplaySetting { setting ->
+                    activeField.apply(setting, color).copy(
+                        recentColors = pushRecentColor(setting.recentColors, color),
+                    )
+                }
+                colorTargetKey = null
+            },
+            canReset = true,
+            onReset = {
+                applyDisplaySetting { setting -> activeField.apply(setting, null) }
+                colorTargetKey = null
+            },
+        )
+    }
+
+    if (showSchemeStyleDialog) {
+        ThemeSchemeStyleDialog(
+            current = displaySetting.themeSchemeStyle,
+            onDismiss = { showSchemeStyleDialog = false },
+            onSelect = { style ->
+                updateDisplaySetting(displaySetting.copy(themeSchemeStyle = style))
+                showSchemeStyleDialog = false
+            },
+        )
+    }
+}
+
+/** 配色风格的中文名，设置在副标题里显示 */
+internal fun themeSchemeStyleLabel(style: ThemeSchemeStyle): String = when (style) {
+    ThemeSchemeStyle.SOFT -> "柔和"

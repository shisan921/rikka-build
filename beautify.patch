+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    modifier = Modifier.padding(horizontal = 16.dp),
+                )
+            }
+        }
+    }
+}
+
+/**
+ * 四个可以放背景图的位置。[prefix] 同时用作内部文件名前缀，方便换图时清掉同一项的旧图。
+ */
+private enum class ImageSlot(val prefix: String) {
+    INPUT("input-bg"),
+    DRAWER("drawer-bg"),
+    USER_BUBBLE("user-bubble"),
+    ASSISTANT_BUBBLE("assistant-bubble"),
+}
+
+/** 读某一项当前保存的图片路径（空字符串 = 未设置）。 */
+private fun DisplaySetting.imageOf(slot: ImageSlot): String = when (slot) {
+    ImageSlot.INPUT -> inputBackgroundImage
+    ImageSlot.DRAWER -> drawerBackgroundImage
+    ImageSlot.USER_BUBBLE -> userBubbleImage
+    ImageSlot.ASSISTANT_BUBBLE -> assistantBubbleImage
+}
+
+/** 把图片路径写到对应字段，[path] 传空字符串就是清除。 */
+private fun DisplaySetting.withImage(slot: ImageSlot, path: String): DisplaySetting = when (slot) {
+    ImageSlot.INPUT -> copy(inputBackgroundImage = path)
+    ImageSlot.DRAWER -> copy(drawerBackgroundImage = path)
+    ImageSlot.USER_BUBBLE -> copy(userBubbleImage = path)
+    ImageSlot.ASSISTANT_BUBBLE -> copy(assistantBubbleImage = path)
+}
+
+/**
+ * 把相册返回的 [uri] 复制到 `filesDir/images/`，文件名是 `前缀-UUID.jpg`。
+ *
+ * 失败（读取不到、空间不足等）返回 null，调用方保持原来的设置不变。
+ */
+suspend fun copyImageToInternal(context: Context, uri: Uri, prefix: String): String? =
+    withContext(Dispatchers.IO) {
+        runCatching {
+            val dir = File(context.filesDir, "images").apply { mkdirs() }
+            val target = File(dir, "$prefix-${UUID.randomUUID()}.jpg")
+            val copied = context.contentResolver.openInputStream(uri)?.use { input ->
+                target.outputStream().use { output -> input.copyTo(output) }
+                true
+            } ?: false
+            if (!copied) {
+                target.delete()
+                return@runCatching null
+            }
+            // 复制成功之后再清掉同一项的旧图，避免中途失败把正在用的图删掉
+            dir.listFiles()
+                ?.filter { it.name.startsWith("$prefix-") && it.name != target.name }
+                ?.forEach { it.delete() }
+            target.absolutePath
+        }.getOrNull()
+    }

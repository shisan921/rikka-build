+                colors = CustomColors.topBarColors
+            )
+        },
+        modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+        containerColor = CustomColors.topBarColors.containerColor
+    ) { contentPadding ->
+        LazyColumn(
+            modifier = Modifier.fillMaxSize(),
+            contentPadding = contentPadding + PaddingValues(8.dp),
+            verticalArrangement = Arrangement.spacedBy(16.dp)
+        ) {
+            item {
+                CardGroup(
+                    modifier = Modifier.padding(horizontal = 8.dp),
+                    title = { Text("材质") },
+                ) {
+                    item(
+                        headlineContent = { Text("界面材质") },
+                        supportingContent = {
+                            Column {
+                                Text("纯色、磨砂玻璃、液态玻璃")
+                                SingleChoiceSegmentedButtonRow(modifier = Modifier.fillMaxWidth()) {
+                                    SURFACE_MATERIAL_OPTIONS.forEachIndexed { index, (value, label) ->
+                                        SegmentedButton(
+                                            selected = material == value,
+                                            onClick = {
+                                                updateDisplaySetting(displaySetting.copy(surfaceMaterial = value))
+                                            },
+                                            shape = SegmentedButtonDefaults.itemShape(
+                                                index = index,
+                                                count = SURFACE_MATERIAL_OPTIONS.size,
+                                            ),
+                                        ) {
+                                            Text(label)
+                                        }
+                                    }
+                                }
+                                TextButton(
+                                    onClick = {
+                                        updateDisplaySetting(
+                                            displaySetting.copy(surfaceMaterial = DEFAULT_SURFACE_MATERIAL)
+                                        )
+                                    },
+                                    modifier = Modifier.align(Alignment.End),
+                                ) {
+                                    Text("恢复默认")
+                                }
+                            }
+                        },
+                    )
+                    item(
+                        headlineContent = { Text("模糊强度") },
+                        supportingContent = {
+                            Column {
+                                Text("只影响磨砂玻璃 / 液态玻璃，0 就是完全清晰")
+                                Row(
+                                    modifier = Modifier.fillMaxWidth(),
+                                    verticalAlignment = Alignment.CenterVertically,
+                                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                                ) {
+                                    Slider(
+                                        value = blurRadius.toFloat(),
+                                        onValueChange = {
+                                            updateDisplaySetting(
+                                                displaySetting.copy(
+                                                    materialBlurRadius = it.roundToInt()
+                                                        .coerceIn(MIN_MATERIAL_BLUR, MAX_MATERIAL_BLUR)
+                                                )
+                                            )
+                                        },
+                                        valueRange = MIN_MATERIAL_BLUR.toFloat()..MAX_MATERIAL_BLUR.toFloat(),
+                                        steps = (MAX_MATERIAL_BLUR - MIN_MATERIAL_BLUR - 1) / 2,
+                                        modifier = Modifier.weight(1f)
+                                    )
+                                    Text(text = "${blurRadius} dp")
+                                }
+                                TextButton(
+                                    onClick = {
+                                        updateDisplaySetting(
+                                            displaySetting.copy(materialBlurRadius = DEFAULT_MATERIAL_BLUR)
+                                        )
+                                    },
+                                    modifier = Modifier.align(Alignment.End),
+                                ) {
+                                    Text("恢复默认")
+                                }
+                            }
+                        },
+                    )
+                    item(
+                        headlineContent = { Text("聊天气泡实时模糊") },
+                        supportingContent = {
+                            Column {
+                                Text("给用户 / AI 气泡加背后模糊，滚动时比较吃性能，默认关闭")
+                                TextButton(
+                                    onClick = {
+                                        updateDisplaySetting(

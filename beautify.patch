+@Composable
+private fun userBubbleContainer(setting: DisplaySetting): Color {
+    val custom = setting.userBubbleColor
+    val base = if (custom != null) {
+        Color(custom)
+    } else {
+        MaterialTheme.colorScheme.primaryContainer.copy(alpha = setting.bubbleOpacity)
+    }
+    // 开了气泡实时模糊就留一点透明度，否则气泡完全不透明，背后的模糊看不见
+    return if (setting.bubbleRealtimeBlur) base.copy(alpha = (base.alpha * 0.55f).coerceIn(0.05f, 1f)) else base
+}
+
+@Composable
+private fun assistantBubbleContainer(setting: DisplaySetting): Color {
+    val custom = setting.assistantBubbleColor
+    val base = if (custom != null) {
+        Color(custom)
+    } else {
+        MaterialTheme.colorScheme.surfaceContainerHigh.copy(alpha = setting.bubbleOpacity)
+    }
+    // 同上：气泡模糊开着时给模糊留出可见度
+    return if (setting.bubbleRealtimeBlur) base.copy(alpha = (base.alpha * 0.55f).coerceIn(0.05f, 1f)) else base
+}

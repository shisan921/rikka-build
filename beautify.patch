+
+/**
+ * 透明度设置页：聊天气泡 / 思维链 / 侧边栏元素三个透明度。
+ *
+ * 全部是 0f..1f，默认值 1f（= 完全不透明，和原版表现一致）。
+ */
+@Composable
+fun SettingPreferencesAlphaPage(vm: SettingVM = koinViewModel()) {
+    val settings by vm.settings.collectAsStateWithLifecycle()
+    var displaySetting by remember(settings) { mutableStateOf(settings.displaySetting) }
+
+    fun updateDisplaySetting(setting: DisplaySetting) {
+        displaySetting = setting
+        vm.updateSettings(settings.copy(displaySetting = setting))
+    }
+
+    val scrollBehavior = TopAppBarDefaults.exitUntilCollapsedScrollBehavior()
+
+    val alphaFields = listOf(
+        AlphaField(
+            title = "聊天气泡不透明度",
+            description = "只影响气泡底色，文字不跟着变淡",
+            value = displaySetting.bubbleOpacity,
+            onUpdate = { updateDisplaySetting(displaySetting.copy(bubbleOpacity = it)) },
+        ),
+        AlphaField(
+            title = "思维链透明度",
+            description = "思维链卡片的底色透明度",
+            value = displaySetting.reasoningAlpha,
+            onUpdate = { updateDisplaySetting(displaySetting.copy(reasoningAlpha = it)) },
+        ),
+        AlphaField(
+            title = "侧边栏元素透明度",
+            description = "侧边栏内所有元素整体的透明度",
+            value = displaySetting.drawerElementAlpha,
+            onUpdate = { updateDisplaySetting(displaySetting.copy(drawerElementAlpha = it)) },
+        ),
+    )
+
+    Scaffold(
+        topBar = {
+            LargeFlexibleTopAppBar(
+                title = { Text("透明度设置") },
+                navigationIcon = {
+                    BackButton()
+                },
+                scrollBehavior = scrollBehavior,
+                colors = CustomColors.topBarColors
+            )
+        },
+        modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+        containerColor = CustomColors.topBarColors.containerColor
+    ) { contentPadding ->
+        LazyColumn(
+            modifier = Modifier.fillMaxSize(),
+            contentPadding = contentPadding + PaddingValues(8.dp),
+            verticalArrangement = Arrangement.spacedBy(16.dp)
+        ) {
+            item {
+                CardGroup(
+                    modifier = Modifier.padding(horizontal = 8.dp),
+                ) {
+                    alphaFields.forEach { field ->
+                        item(
+                            headlineContent = { Text(field.title) },
+                            supportingContent = {
+                                Column {
+                                    Text(field.description)
+                                    Row(
+                                        modifier = Modifier.fillMaxWidth(),
+                                        verticalAlignment = Alignment.CenterVertically,
+                                        horizontalArrangement = Arrangement.spacedBy(8.dp),
+                                    ) {
+                                        Slider(
+                                            value = field.value.coerceIn(0f, 1f),
+                                            onValueChange = field.onUpdate,
+                                            valueRange = 0f..1f,
+                                            steps = 9,
+                                            modifier = Modifier.weight(1f)
+                                        )
+                                        Text(text = "${(field.value.coerceIn(0f, 1f) * 100).roundToInt()}%")
+                                    }
+                                    TextButton(
+                                        onClick = { field.onUpdate(1f) },
+                                        modifier = Modifier.align(Alignment.End),
+                                    ) {
+                                        Text("恢复默认")
+                                    }
+                                }
+                            },
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
+
+/**
+ * 一项透明度设置。[onUpdate] 直接把新的 0f..1f 值写回设置。
+ */
+private data class AlphaField(
+    val title: String,
+    val description: String,
+    val value: Float,
+    val onUpdate: (Float) -> Unit,
+)

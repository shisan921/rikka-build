+/** 四档材质和显示名，顺序就是分段按钮的顺序 */
+private val materialChoices: List<Pair<SurfaceMaterial, String>> = listOf(
+    SurfaceMaterial.SOLID to "纯色",
+    SurfaceMaterial.TRANSLUCENT to "半透明",
+    SurfaceMaterial.FROSTED to "磨砂",
+    SurfaceMaterial.LIQUID to "液态玻璃",
+)
+
+/** 一行四选一的分段按钮（Material3 SingleChoiceSegmentedButtonRow） */
+@Composable
+private fun MaterialSegmentedRow(
+    selected: SurfaceMaterial,
+    onSelect: (SurfaceMaterial) -> Unit,
+) {
+    SingleChoiceSegmentedButtonRow(modifier = Modifier.fillMaxWidth()) {
+        materialChoices.forEachIndexed { index, choice ->
+            SegmentedButton(
+                selected = selected == choice.first,
+                onClick = { onSelect(choice.first) },
+                shape = SegmentedButtonDefaults.itemShape(
+                    index = index,
+                    count = materialChoices.size,
+                ),
+            ) {
+                Text(choice.second)
+            }
+        }
+    }
+}
+
+/** 当前材质的说明文字：输入框和气泡共用一套文案，气泡多考虑实时模糊开关 */
+private fun materialDescription(material: SurfaceMaterial, realtimeBlur: Boolean): String =
+    when (material) {
+        SurfaceMaterial.SOLID -> "纯色：与原来完全一致，不额外绘制任何东西"
+        SurfaceMaterial.TRANSLUCENT -> "半透明：底色压到 55%，不模糊、不额外开销"
+        SurfaceMaterial.FROSTED -> if (realtimeBlur) {
+            "磨砂玻璃：背景实时模糊 + 半透明底色"
+        } else {
+            "磨砂玻璃：目前只保留半透明底色，等模糊开关打开才会真的模糊"
+        }
+
+        SurfaceMaterial.LIQUID -> if (realtimeBlur) {
+            "液态玻璃：更强的模糊 + 玻璃边缘高光和渐变"
+        } else {
+            "液态玻璃：目前只保留半透明底色，等模糊开关打开才会真的模糊"
+        }
+    }

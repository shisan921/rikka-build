+                    surface = AMOLED_DARK_BACKGROUND,
+                )
+            } else {
+                seeded
+            }
+        } else {
+            colorSchemeConverted
+        }
+    }
+    // 主色调自定义：按钮/链接等 primary 相关控件跟着走，没设就还是主题原来的主色
+    // 覆盖 primary 时顺手把 onPrimary 按亮度修正，避免用户选白色后白底白字
+    val customPrimaryColor = settings.displaySetting.primaryColor
+    val colorSchemeFinal = remember(colorSchemeSeeded, customPrimaryColor) {
+        if (customPrimaryColor != null) {
+            val primary = Color(customPrimaryColor)
+            colorSchemeSeeded.copy(primary = primary, onPrimary = onColorFor(primary))
+        } else {
+            colorSchemeSeeded
+        }
+    }

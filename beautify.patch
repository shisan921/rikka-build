+/** 配色风格的中文名，设置在副标题里显示 */
+internal fun themeSchemeStyleLabel(style: ThemeSchemeStyle): String = when (style) {
+    ThemeSchemeStyle.SOFT -> "柔和"
+    ThemeSchemeStyle.FAITHFUL -> "贴近原色"
+    ThemeSchemeStyle.MONOCHROME -> "单色灰阶"
+    ThemeSchemeStyle.NEUTRAL -> "中性"
+}
+
+/** 配色风格的单选弹窗：点一项立刻生效，底部给「恢复默认」回到柔和 */
+@Composable

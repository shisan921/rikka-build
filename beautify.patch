+        // ① 普通文件路径（设置里那些插图素材就是这么存的）
+        if (source.isFile) {
+            return runCatching {
+                if (!dir.exists()) dir.mkdirs()
+                val out = target(slot)
+                if (out.absolutePath == source.absolutePath) return out.absolutePath
+                if (out.exists()) out.delete()
+                source.copyTo(out, overwrite = true)
+                out.absolutePath
+            }.getOrElse { "" }
+        }
+        // ② URI 形式（相册选的助手背景图走的是 content:// 或 file://，不是绝对路径）
+        if (path.startsWith("content://") || path.startsWith("file://")) {
+            return runCatching {
+                if (!dir.exists()) dir.mkdirs()
+                val out = target(slot)
+                val input = context.contentResolver.openInputStream(Uri.parse(path))
+                if (input == null) {
+                    // 打不开（权限失效 / 文件没了）→ 退回原串，让 Coil 自己再试一次
+                    if (keepNonFile) path else ""
+                } else {
+                    input.use { source -> out.outputStream().use { source.copyTo(it) } }
+                    out.absolutePath
+                }
+            }.getOrElse { if (keepNonFile) path else "" }
+        }
+        // ③ 网络链接之类：复制不了，原样留着
+        return if (keepNonFile) path else ""
+    }
+
+    return preset.copy(
+        inputBackgroundImage = copySlot(preset.inputBackgroundImage, SLOT_INPUT),
+        drawerBackgroundImage = copySlot(preset.drawerBackgroundImage, SLOT_DRAWER),
+        userBubbleImage = copySlot(preset.userBubbleImage, SLOT_USER_BUBBLE),
+        assistantBubbleImage = copySlot(preset.assistantBubbleImage, SLOT_ASSISTANT_BUBBLE),
+        fullScreenEditorBgImage = copySlot(preset.fullScreenEditorBgImage, SLOT_FULL_SCREEN),
+        assistantBackgroundImage = copySlot(
+            preset.assistantBackgroundImage,
+            SLOT_ASSISTANT_BG,
+            keepNonFile = true,
+        ),
+    )
+}
+
+/**
+ * 删除装扮时顺手清掉它的图片副本，别在手机里攒垃圾。
+ * 找不到、删不掉都不影响主流程。
+ */
+fun deleteDecorImages(context: Context, presetId: String) {
+    if (presetId.isBlank()) return
+    val dir = File(context.filesDir, DECOR_IMAGE_DIR)
+    runCatching {
+        dir.listFiles()
+            ?.filter { it.name.startsWith("$presetId-") }
+            ?.forEach { it.delete() }
+    }
+}

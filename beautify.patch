+package me.rerere.rikkahub.ui.theme
+
+import androidx.compose.material3.ColorScheme
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.luminance
+import dynamiccolor.ColorSpecs
+import dynamiccolor.DynamicScheme
+import dynamiccolor.Variant
+import hct.Hct
+import me.rerere.material3.toColorScheme
+import me.rerere.rikkahub.data.datastore.ThemeSchemeStyle
+
+/**
+ * 基色彩度低于这个值时，整条配色改走 [Variant.NEUTRAL]。
+ *
+ * 原因：TONAL_SPOT 在基色 chroma≈0（纯白 / 浅灰 / 深灰）时会退回一个默认色相，
+ * 生成出来的灰阶会发青发绿，所以纯灰基色直接交给 NEUTRAL 出干净灰阶。
+ */
+private const val MIN_CHROMA_FOR_VARIANT = 8.0
+
+/**
+ * 配色风格 → material-color-utilities 的 Variant。
+ *
+ * 只映射到本项目 material-color-utilities 里确实存在的常量：
+ * TONAL_SPOT / CONTENT / MONOCHROME / NEUTRAL。
+ */
+fun ThemeSchemeStyle.toVariant(): Variant = when (this) {
+    ThemeSchemeStyle.SOFT -> Variant.TONAL_SPOT
+    ThemeSchemeStyle.FAITHFUL -> Variant.CONTENT
+    ThemeSchemeStyle.MONOCHROME -> Variant.MONOCHROME
+    ThemeSchemeStyle.NEUTRAL -> Variant.NEUTRAL
+}
+
+/**
+ * 用单个基色生成整套 Material 3 配色。
+ *
+ * 算法和 [CustomTheme.generateColorScheme] 一致（同样的 spec / platform / 对比度），
+ * 区别只是只需要用户给一个颜色，背景 / 卡片 / 文字 / 描边全部从这条基色推导，
+ * 所以用户选一个很亮或很淡的颜色也不会出现「白底白字」。
+ *
+ * [style] 决定调色板变体；基色 chroma 过低时无视 [style] 统一走 NEUTRAL。
+ *
+ * 纯函数，调用方用 `remember(seed, dark, style)` 缓存即可。
+ */
+fun generateSchemeFromSeed(
+    seed: Long,
+    dark: Boolean,
+    style: ThemeSchemeStyle = ThemeSchemeStyle.SOFT,
+): ColorScheme {
+    val sourceHct = Hct.fromInt(seed.toInt())
+    val specVersion = DynamicScheme.DEFAULT_SPEC_VERSION
+    val platform = DynamicScheme.DEFAULT_PLATFORM
+    val contrastLevel = 0.0
+    val colorSpec = ColorSpecs.get(specVersion)
+    // 白 / 灰基色：chroma 几乎为 0，按风格走会拿到默认色相的青绿色，这里统一拉回中性灰阶
+    val variant = if (sourceHct.chroma < MIN_CHROMA_FOR_VARIANT) {
+        Variant.NEUTRAL
+    } else {
+        style.toVariant()
+    }
+
+    val scheme = DynamicScheme(
+        sourceHct,
+        variant,
+        dark,
+        contrastLevel,
+        platform,
+        specVersion,
+        colorSpec.getPrimaryPalette(
+            variant, sourceHct, dark, platform, contrastLevel,
+        ),
+        colorSpec.getSecondaryPalette(
+            variant, sourceHct, dark, platform, contrastLevel,
+        ),
+        colorSpec.getTertiaryPalette(
+            variant, sourceHct, dark, platform, contrastLevel,
+        ),
+        colorSpec.getNeutralPalette(
+            variant, sourceHct, dark, platform, contrastLevel,
+        ),
+        colorSpec.getNeutralVariantPalette(
+            variant, sourceHct, dark, platform, contrastLevel,
+        ),
+        colorSpec.getErrorPalette(
+            variant, sourceHct, dark, platform, contrastLevel,
+        ),
+    )
+    return scheme.toColorScheme()
+}
+
+/**
+ * 覆盖 primary 时配套的 onPrimary：亮度大于 0.5 用黑字，否则用白字。
+ * 只服务 [Theme] 里「主色调」这一对，不改其它容器色。
+ */
+fun onColorFor(background: Color): Color {
+    return if (background.luminance() > 0.5f) Color.Black else Color.White
+}

+ *   `quoteOuterDecor = NONE` 时一个字符都不插，渲染路径与老版本逐像素一致；
+ * - 代码天然不受影响：行内代码（CODE_SPAN / `<code>`）和代码块（CODE_FENCE / `<pre>`）在渲染器里
+ *   都有独立分支，文本压根不经过 [appendQuotedText]，不需要正则去跳过 ``` 围栏；
+ * - 只对 AI 消息生效：聊天正文按 `message.role` 把 [LocalQuoteStyleEnabled] 提供下去，
+ *   用户自己发的消息整棵子树都是 false，SpanStyle 和自绘都不挂；
+ * - 关闭开关（或角色门禁为 false）时 [quoteStyleOrNull] 返回 null，[appendQuotedText] 退化成 `append(text)`，
+ *   渲染路径连 `onTextLayout` / `drawBehind` 都不加，与改动前的输出逐像素一致。
+ */
+
+/** 中文左引号、中文右引号、英文双引号。单引号 / 「」不处理，避免把英文撇号和日式引用一起染上色。 */
+private const val QUOTE_OPEN = '\u201C'   // “
+private const val QUOTE_CLOSE = '\u201D'  // ”
+private const val QUOTE_ASCII = '"'
+
+/** 引号区间用的字符串注解 tag：AnnotatedString 建好后再按它把区间取回来 */
+internal const val QUOTE_RANGE_ANNOTATION = "rikka.quote.range"
+
+/** 空区间表（共享常量，任何地方都不许改它的元素） */
+internal val EMPTY_QUOTE_RANGES: IntArray = IntArray(0)
+
+/**
+ * 当前子树要不要吃「对白样式」。
+ *
+ * 默认 `true`，让设置页预览 / 调试页 / 导出页这些直接调 `MarkdownBlock` 的地方保持原来的表现；
+ * 聊天正文按**消息角色**由调用方显式提供：AI 消息 true、用户消息 false（用户自己发的话不染色）。
+ *
+ * 走 CompositionLocal 而不是给递归的 `MarkdownNode` / `Paragraph` 逐个加参数：
+ * `MarkdownBlock` 里提供一次，整棵子树（含 `MarkdownNew` 的 HTML 兜底路径、行内文本节点）都能读到，
+ * `quoteStyleOrNull()` 在最里层直接判断，不用改十几处递归签名。
+ */
+internal val LocalQuoteStyleEnabled = compositionLocalOf { true }
+
+/**
+ * 纯函数：把一段纯文本按引号切成若干段，标出哪几段在引号内。
+ *
+ * 规则（结果拼起来永远等于入参 [text]，不会有字符丢失）：
+ * 1. `“` 与 `"` 当作开引号，`”` 当作闭引号；已经在引号里时遇到 `“` / `"` 当作闭引号（多引号混用的兜底）；
+ * 2. 引号符号本身和里面的内容一起上色（和常见的对话高亮一致），标点也算在内；
+ * 3. **必须成对出现才高亮**：段落末尾还没闭合的引号（流式输出打了一半 / AI 少打一个引号）整段按普通文本处理，
+ *    不会把后面正文一起染上色；
+ * 4. 没有引号字符时原样返回一段普通文本，零额外开销。
+ */
+internal fun splitQuotedSegments(text: String): List<QuotedTextSegment> {
+    if (text.isEmpty()) return emptyList()
+    val hasQuote = text.any { it == QUOTE_OPEN || it == QUOTE_CLOSE || it == QUOTE_ASCII }
+    if (!hasQuote) return listOf(QuotedTextSegment(text = text, quoted = false))
+
+    val segments = ArrayList<QuotedTextSegment>(8)
+    val buffer = StringBuilder()
+    var inQuote = false
+
+    // 按顺序吐出 buffer 里的内容，绝不改变字符相对位置（拼回去必须和原文一模一样）
+    fun flush(quoted: Boolean) {
+        if (buffer.isNotEmpty()) {
+            segments.add(QuotedTextSegment(text = buffer.toString(), quoted = quoted))
+            buffer.setLength(0)
+        }
+    }
+
+    // 后面还有没有能闭合的引号（流式输出打一半时用来判断这一对是否成立）
+    fun hasCloseAfter(index: Int): Boolean {
+        var i = index + 1
+        while (i < text.length) {
+            val c = text[i]
+            if (c == QUOTE_CLOSE || c == QUOTE_ASCII) return true
+            i++
+        }
+        return false
+    }
+
+    text.forEachIndexed { index, ch ->
+        when (ch) {
+            QUOTE_OPEN, QUOTE_ASCII -> {
+                if (!inQuote) {
+                    if (!hasCloseAfter(index)) {
+                        // 找不到闭合引号：这个符号按普通文本处理，后面的正文不会被染色
+                        buffer.append(ch)
+                    } else {
+                        flush(false)
+                        inQuote = true
+                        // 引号符号本身跟着内容一起上色
+                        segments.add(QuotedTextSegment(text = ch.toString(), quoted = true))
+                    }
+                } else {
+                    flush(true)
+                    inQuote = false
+                    segments.add(QuotedTextSegment(text = ch.toString(), quoted = true))
+                }
+            }
+
+            QUOTE_CLOSE -> {
+                if (inQuote) {
+                    flush(true)
+                    inQuote = false
+                    segments.add(QuotedTextSegment(text = ch.toString(), quoted = true))
+                } else {
+                    buffer.append(ch)
+                }
+            }
+
+            else -> buffer.append(ch)
+        }
+    }
+    // 段尾：没闭合的引号内容按普通文本处理
+    flush(false)
+    return segments
+}
+
+/** [splitQuotedSegments] 的一段结果。[quoted] 为 true 表示这段文字要被上色。 */
+internal data class QuotedTextSegment(
+    val text: String,
+    val quoted: Boolean,
+)
+
+/**
+ * 一条消息的「对白样式」。
+ *
+ * [color]：引号内文字颜色（永远走 SpanStyle）；
+ * [background]：已经乘好透明度的底色（见 [quoteStyleOrNull]），null 表示不加底色；
+ * [solidUnderline] / [dashedUnderline] / [dottedUnderline]：实线、虚线、点线三个**独立**开关，
+ * 各画各的线；三个 `...Color` 字段为 null 时该颜色跟随 [color]；
+ * [leadingBar] 行首竖线开关，[leadingBarColor] 为 null 时跟随 [color]；
+ * [backgroundCorner] 底色圆角（dp，0 = 直角）；[backgroundGap] 行与行底色之间的留白（dp，上下各一半）；
+ * [selfDrawn] 表示这条渲染路径会把底色 / 下划线 / 竖线交给 [quoteDecoration] 自绘，
+ * SpanStyle 就只输出文字颜色（[MarkdownNew] 的 HTML 兜底路径仍然是 false，走旧的 SpanStyle）。
+ *
+ * 整个对象是不可变 data class，可以直接当 `remember` 的 key 用（Compose 的 `Color` 是值类，
+ * 比较的是 ARGB），改任何一个字段（含新加的实线 / 虚线 / 点线开关与颜色）都会让缓存失效重新拼 AnnotatedString。
+ */
+internal data class QuoteStyle(
+    val color: Color,
+    val background: Color? = null,
+    val solidUnderline: Boolean = false,
+    val solidUnderlineColor: Color? = null,
+    val dashedUnderline: Boolean = false,
+    val dashedUnderlineColor: Color? = null,
+    val dottedUnderline: Boolean = false,
+    val dottedUnderlineColor: Color? = null,
+    val leadingBar: Boolean = false,
+    val leadingBarColor: Color? = null,
+    /** 行首竖线高度（按行高的比例，0.3f..1.2f）：1f = 占满整行，默认 0.7f 只占中间七成 */
+    val leadingBarHeightScale: Float = 0.7f,
+    /** 行首竖线左右位置（dp，-4..8）：x = 开引号字符左边缘 - 这个值，正数把竖线往左推 */
+    val leadingBarOffsetDp: Int = 1,
+    /** 行首竖线粗细（dp，1..5）：drawRect / drawRoundRect 的 width，默认 2dp */
+    val quoteBarWidthDp: Float = 2f,
+    val underlineInsetDp: Int = 2,
+    val backgroundCorner: Int = 4,
+    /**
+     * 行与行之间底色留白（dp），**上下各取一半**（默认 2dp）。
+     * 注意它只管「行与行」之间；同一行里开引号 / 闭引号和里面的文字永远是一整块
+     * （首尾相接的区间在绘制前会先合并，见 [mergeTouchingRanges]）。
+     */
+    val backgroundGap: Int = 2,
+    /** 下划线与文字的距离（dp，0..10）：第一条线的 y = baseline + 这个值 */
+    val underlineOffset: Int = 2,
+    /**
+     * 虚线与点线的**密度**（0.2f..3.0f，滑块步进 0.1）：数值越大越密。
+     * 代码里实际乘的是 `1f / dashScale`（见 [quoteDecoration]），所以字段名保持 dashScale 不变、
+     * 老数据也不用迁移。
+     */
+    val dashScale: Float = 1f,
+    /**
+     * 外层符号的开符号 / 闭符号（`「` `」` / `『` `』` / `（` `）`），空串表示不套外层符号。
+     *
+     * 由 [quoteStyleOrNull] 按 [me.rerere.rikkahub.data.datastore.QuoteOuterDecor] 映射成实际字符，
+     * 这里刻意存**字符**而不是枚举：绘制 / 拼字符串的地方不需要知道有哪几种样式，
+     * 设置页加一种新符号也不用改这里。两个都为空串时 [hasOuterDecor] 为 false，一个字符都不插。
+     */
+    val outerOpen: String = "",
+    val outerClose: String = "",
+    /** 符号与内容之间的空隙（0..3）：单位是薄空格 U+2009 的重复次数，只在 [hasOuterDecor] 时生效 */
+    val outerSpace: Int = 0,
+    /** 符号是否跟随引号高亮色（true = 符号也用 [color]；false = 符号用正文色） */
+    val outerFollowHighlight: Boolean = true,
+    /**
+     * 符号的字号（由「符号大小」倍率 × 正文字号在 [quoteStyleOrNull] 里算好），
+     * `TextUnit.Unspecified` = 不设字号（倍率 1.0x 时就是它，保证默认状态逐像素不变）。
+     *
+     * 只影响符号自己那一两个字符：内容照旧用外层文字样式，range / 底色 / 下划线全部按内容算，
+     * 所以符号调大也不会让装饰范围跟着变宽。
+     */
+    val outerFontSize: TextUnit = TextUnit.Unspecified,
+    /**
+     * 符号自己用的字体。null = 不设（跟随正文样式，默认行为）；
+     * 非 null 时给符号单独套一个字体——用来解决「自定义中文字体缺 U+300C 字形、
+     * 系统借来的字体跟正文不搭」的问题。
+     */
+    val outerFontFamily: FontFamily? = null,
+    val selfDrawn: Boolean = false,
+) {
+    /** 有没有要画的下划线（实线 / 虚线 / 点线随便开一个都算，全开就是三条线） */
+    val hasUnderline: Boolean get() = solidUnderline || dashedUnderline || dottedUnderline
+
+    /** 要不要套外层符号：开符号和闭符号至少有一个非空（`NONE` 时两个都是空串） */
+    val hasOuterDecor: Boolean get() = outerOpen.isNotEmpty() || outerClose.isNotEmpty()
+
+    /** 自绘路径上真有东西要画吗：三样装饰全无时连 drawBehind 都不挂 */
+    val needsDecoration: Boolean
+        get() = selfDrawn && (background != null || hasUnderline || leadingBar)
+}
+
+/**
+ * 把 [QuoteStyle] 拼成交给渲染层的 `SpanStyle`。
+ *
+ * - 自绘路径（[QuoteStyle.selfDrawn] = true）：**只给文字颜色**，底色 / 下划线 / 竖线全部由
+ *   [quoteDecoration] 画，SpanStyle 不再画整块矩形背景，也不再受 `TextDecoration` 只能实线的限制；
+ * - 旧路径（HTML 兜底）：颜色 + 半透明底色 + 实线下划线。旧路径只能画实线
+ *   （`TextDecoration` 的能力边界），所以这里只看 [QuoteStyle.solidUnderline]，
+ *   虚线在 HTML 兜底分支上画不出来，正经的对话正文走的是上面那条自绘路径。
+ *
+ * 刻意只动这几样：fontFamily / fontSize / fontWeight / fontStyle / shadow 都不碰，
+ * 外面已有的加粗、斜体、删除线、链接、行内公式样式不会被破坏。
+ */
+internal fun QuoteStyle.toSpanStyle(): SpanStyle {
+    if (selfDrawn) {
+        return SpanStyle(color = color)
+    }
+    return SpanStyle(
+        color = color,
+        background = background ?: Color.Unspecified,
+        // 旧路径只有实线的能力（虚线需要 PathEffect，只有自绘分支才画得出来）
+        textDecoration = if (solidUnderline) TextDecoration.Underline else null,
+    )
+}
+
+/**
+ * 外层符号与内容之间的空隙，单位是**薄空格 U+2009**（不是普通空格：普通空格在中文正文里太宽，
+ * 也不该被 Markdown 的行尾裁剪 / 换行逻辑盯上）。
+ */
+private const val THIN_SPACE = '\u2009'
+
+/** 「符号与内容间距」滑块上限（0..3，和设置页滑块一致），同时是下面查表数组的长度 */
+private const val MAX_OUTER_SPACE = 3
+
+/** 「符号与内容间距」允许的负值（负 = 把符号往内容方向压，抵消括号自身的左右留白） */
+private const val MIN_OUTER_SPACE = -3
+
+/**
+ * 薄空格的重复串查表：0 → ""、1 → " "、2 / 3 依次加长。
+ *
+ * 用查表而不是 `String.repeat(n)`：`repeat` 每次都要新建 StringBuilder + String，
+ * 而这段代码在每条消息重建 `AnnotatedString` 时都会跑一次（滑块值只有 0..3 四种，表里够用）。
+ */
+private val THIN_SPACE_RUNS: Array<String> =
+    Array(MAX_OUTER_SPACE + 1) { index -> THIN_SPACE.toString().repeat(index) }
+
+/** 往正文里插一个外层符号：符号本身不带底色 / 下划线，只有「跟随高亮色」时才上一条纯颜色 SpanStyle */
+private fun AnnotatedString.Builder.appendOuterSymbol(symbol: String, style: SpanStyle?) {
+    if (symbol.isEmpty()) return
+    if (style == null) {
+        // 用正文色：什么都不加，由外层已有的文字样式决定颜色
+        append(symbol)
+    } else {
+        withStyle(style) { append(symbol) }
+    }
+}
+
+/** 往正文里插 [count] 个薄空格（0 个时什么都不做，保证 `NONE` / 间距 0 时逐像素不变） */
+private fun AnnotatedString.Builder.appendOuterSpaces(count: Int) {
+    if (count <= 0) return
+    append(THIN_SPACE_RUNS[count.coerceIn(0, MAX_OUTER_SPACE)])
+}
+
+/**
+ * 往 AnnotatedString 里追加一段纯文本，[quoteStyle] 非 null 时给引号内的文字上样式。
+ *
+ * 自绘路径下会同时给每段引号区间打一个 [QUOTE_RANGE_ANNOTATION] 字符串注解，
+ * 事后用 [collectQuoteRanges] 取回来交给 [quoteDecoration]，避免给递归的 append 函数加出参。
+ *
+ * [quoteStyle] 为 null 时退化成 `append(text)`，逐像素与改动前的渲染一致。
+ *
+ * 「外层符号」的插入顺序（`quoteStyle.hasOuterDecor` 为真时才做，否则一个字符都不插）：
+ *
+ * ```
+ * 非引号段 …  [开符号] [薄空格 × 间距] [“ 内容 ”（原样，带 SpanStyle）] [薄空格 × 间距] [闭符号] … 非引号段
+ * ```
+ *
+ * **区间只记「内容」的起止**：`start` 是在符号 / 薄空格都 append 完之后才取的 `length`，
+ * 所以注解的 offset 直接就是最终字符串里的真实下标——底色 / 下划线 / 行首竖线全都按这个区间算，
+ * 外层符号永远不会被圈进装饰范围里（符号插得再多，装饰也不会变宽或错位）。
+ */
+internal fun AnnotatedString.Builder.appendQuotedText(text: String, quoteStyle: QuoteStyle?) {
+    if (quoteStyle == null) {
+        append(text)
+        return
+    }
+    val spanStyle = quoteStyle.toSpanStyle()
+    val tagRanges = quoteStyle.selfDrawn
+    // 外层符号：NONE 时 hasOuterDecor == false，下面的分支一个字符都不会插
+    val appendOuter = quoteStyle.hasOuterDecor
+    val outerSpaceRaw = if (appendOuter) quoteStyle.outerSpace.coerceIn(MIN_OUTER_SPACE, MAX_OUTER_SPACE) else 0
+    // 正数 = 插薄空格；负数 = 给符号加负字距，把两边往里收
+    val outerSpace = outerSpaceRaw.coerceAtLeast(0)
+    val outerPull = (-outerSpaceRaw).coerceAtLeast(0)
+    // 每档只收 0.035em：全角括号自带约 0.2em 的左右留白，收太多就会把引号压到括号下面
+    val pullLetterSpacing = if (outerPull > 0) (-0.04f * outerPull).em else TextUnit.Unspecified
+    // 符号自己的 SpanStyle：**不能复用 spanStyle**（旧路径的 spanStyle 带底色 + 下划线，
+    // 套在符号上会让符号也被涂上底色），这里只拼「颜色 + 字号」两样：
+    // - 颜色：跟随高亮色时给 color，否则 Unspecified（= 沿用正文颜色）；
+    // - 字号：「符号大小」倍率算出来的 [QuoteStyle.outerFontSize]，1.0x 时是 Unspecified（不设）。
+    val outerSymbolStyle = if (
+        appendOuter && (quoteStyle.outerFollowHighlight || quoteStyle.outerFontSize.isSpecified)
+    ) {
+        SpanStyle(
+            color = if (quoteStyle.outerFollowHighlight) quoteStyle.color else Color.Unspecified,
+            fontSize = quoteStyle.outerFontSize,
+            letterSpacing = pullLetterSpacing,
+            fontFamily = quoteStyle.outerFontFamily,
+        )
+    } else {
+        null
+    }
+    // 一段连续 quoted 段 = 一个完整的引号区间（开引号 / 正文 / 闭引号都在里面），外层符号一左一右各一处
+    var inQuotedRun = false
+    splitQuotedSegments(text).forEach { segment ->
+        if (segment.quoted) {
+            if (!inQuotedRun) {
+                inQuotedRun = true
+                if (appendOuter) {
+                    // ① 先插开符号和它后面的空隙，再取 start，注解才会落在最终字符串的正确位置
+                    appendOuterSymbol(quoteStyle.outerOpen, outerSymbolStyle)
+                    appendOuterSpaces(outerSpace)
+                }
+            }
+            val start = length
+            withStyle(spanStyle) {
+                append(segment.text)
+            }
+            if (tagRanges && length > start) {
+                addStringAnnotation(
+                    tag = QUOTE_RANGE_ANNOTATION,
+                    annotation = "",
+                    start = start,
+                    end = length,
+                )
+            }
+        } else {
+            if (inQuotedRun) {
+                inQuotedRun = false
+                if (appendOuter) {
+                    // ② 空隙 + 闭符号都插在区间**之后**，所以它们不参与任何自绘几何
+                    appendOuterSpaces(outerSpace)
+                    if (outerPull > 0) {
+                        // 负间距只作用在这个零宽字符上：把闭符号往左拉，文字本身一点不动
+                        withStyle(SpanStyle(letterSpacing = pullLetterSpacing)) {
+                            append("\u200B")
+                        }
+                    }
+                    appendOuterSymbol(quoteStyle.outerClose, outerSymbolStyle)
+                }
+            }
+            append(segment.text)
+        }
+    }
+    // 兜底：splitQuotedSegments 保证同一段文本里的引号成对，正常走不到这里；
+    // 真出现「一段文字以引号内的内容结尾」这种极端情况，也把闭符号补齐，不留一个孤零零的开符号
+    if (inQuotedRun && appendOuter) {
+        appendOuterSpaces(outerSpace)
+        if (outerPull > 0) {
+            withStyle(SpanStyle(letterSpacing = pullLetterSpacing)) { append("\u200B") }
+        }
+        appendOuterSymbol(quoteStyle.outerClose, outerSymbolStyle)
+    }
+}
+
+/**
+ * 从建好的 AnnotatedString 里把引号区间捞出来，压成 `[start0, end0, start1, end1, ...]` 的 IntArray。
+ *
+ * 用 IntArray 而不是 `List<IntRange>`：`drawBehind` 里按下标遍历不会创建任何装箱对象，
+ * 结果本身在组合期算一次、交给 `remember` 缓存，绘制阶段零分配。
+ */
+internal fun AnnotatedString.collectQuoteRanges(): IntArray {
+    if (length == 0) return EMPTY_QUOTE_RANGES
+    val found = getStringAnnotations(QUOTE_RANGE_ANNOTATION, 0, length)
+    if (found.isEmpty()) return EMPTY_QUOTE_RANGES
+    val ranges = IntArray(found.size * 2)
+    found.forEachIndexed { index, range ->
+        ranges[index * 2] = range.start
+        ranges[index * 2 + 1] = range.end
+    }
+    return ranges
+}
+
+/**
+ * 把首尾相接（`前一段.end == 后一段.start`）的区间合并成一个。
+ *
+ * 为什么需要：[splitQuotedSegments] 把**开引号 / 闭引号各自单独算一段**、引号里的正文再算一段，
+ * 于是「“你好”」会产出三个相邻区间（引号、正文、引号），每个区间在绘制阶段都要各自画一个
+ * 行矩形 + 左右各内缩 2dp，结果就是**同一行里引号和正文的底色被切成两个矩形，中间露一条缝**
+ * （用户报的「中间断开了」其实是这个，不是行与行之间的空隙）。
+ * 合并之后同一行只有一块底色，行与行之间仍然按 `backgroundGap` 留空隙。
+ *
+ * 纯函数、结果在组合期 remember，绘制阶段不额外分配。
+ */
+internal fun mergeTouchingRanges(ranges: IntArray): IntArray {
+    if (ranges.size < 4) return ranges
+    val merged = IntArray(ranges.size)
+    var outSize = 0
+    var i = 0
+    while (i + 1 < ranges.size) {
+        val start = ranges[i]
+        var end = ranges[i + 1]
+        i += 2
+        // 后面的区间只要和当前区间首尾相接（或已经重叠）就一路吞进来
+        while (i + 1 < ranges.size && ranges[i] <= end) {
+            if (ranges[i + 1] > end) end = ranges[i + 1]
+            i += 2
+        }
+        merged[outSize] = start
+        merged[outSize + 1] = end
+        outSize += 2
+    }
+    return if (outSize == ranges.size) merged else merged.copyOf(outSize)
+}
+
+/** 「符号大小」倍率的下限 / 上限（0.7x..1.5x），和设置页滑块、DisplaySetting 的默认值配套 */
+private const val MIN_OUTER_SCALE = 0.7f
+private const val MAX_OUTER_SCALE = 1.5f
+
+/**
+ * 把「符号大小」倍率折算成符号实际用的字号（纯函数，组合期算一次）。
+ *
+ * - [baseFontSize] 是调用处 `LocalTextStyle.current.fontSize`（正文当前字号，通常是 sp）；
+ * - 倍率夹到 0.7x..1.5x，且**等于 1f 时直接返回 [TextUnit.Unspecified]**：
+ *   不设字号 = 符号与正文同字号，默认状态下与没有这个功能时逐像素一致；
+ * - 正文字号本身是 Unspecified 时也返回 Unspecified，避免拿 NaN 去乘；
+ * - 用 `TextUnit * Float` 而不是 `.value * scale` 再 `.sp`：单位（sp / em）原样保留。
+ *
+ * 注意它只影响符号那一两个字符的绘制尺寸，`AnnotatedString` 里的 range 与自绘几何一点没动。
+ */
+private fun resolveOuterFontSize(scale: Float, baseFontSize: TextUnit): TextUnit {
+    val safeScale = scale.coerceIn(MIN_OUTER_SCALE, MAX_OUTER_SCALE)
+    if (!baseFontSize.isSpecified) return TextUnit.Unspecified
+    if (safeScale == 1f) return TextUnit.Unspecified
+    return baseFontSize * safeScale
+}
+
+/**
+ * 外层符号的**符号表**：`NONE` → 空串（不套），`CORNER` → 「」，`DOUBLE_CORNER` → 『』。
+ *
+ * 单独抽成两个纯函数（而不是给枚举挂字段）：`QuoteStyle` 里只存字符，拼字符串的地方不需要认识枚举，
+ * 以后加样式也只改这两处 + [QuoteOuterDecor] 的一个枚举项。
+ * 全部用 `\u` 转义写，避免源文件编码 / 字体差异把全角符号读错。
+ */
+private fun QuoteOuterDecor.openSymbol(): String = when (this) {
+    QuoteOuterDecor.NONE -> ""
+    QuoteOuterDecor.CORNER -> "\u300C"        // 「
+    QuoteOuterDecor.DOUBLE_CORNER -> "\u300E" // 『
+}
+
+private fun QuoteOuterDecor.closeSymbol(): String = when (this) {
+    QuoteOuterDecor.NONE -> ""
+    QuoteOuterDecor.CORNER -> "\u300D"        // 」
+    QuoteOuterDecor.DOUBLE_CORNER -> "\u300F" // 』
+}
+
+/**
+ * 当前这条消息该用的对白样式：开关关掉就是 null（渲染路径完全不变）；
+ * 开了但没自己选色就跟随主题的正文色（onSurface 取不到时退回 primary）。
+ *
+ * 底色要过三道关：「启用对白底色」开关打开、选了颜色、透明度大于 0；任意一条不满足就不画底色
+ * （不再需要让用户点进取色盘「恢复默认」来关掉底色）。底色的最终 alpha 直接取「背景透明度」滑块
+ * （取色盘里那个 alpha 不参与，避免两处透明度打架）。
+ *
+ * [selfDrawn] 由调用方给：消息正文（[Markdown] 的 Paragraph）传 true，走自绘；
+ * HTML 兜底和独立文本节点不传，保持旧的 SpanStyle 行为。
+ *
+ * 角色门禁：[LocalQuoteStyleEnabled] 为 false 时直接返回 null（用户自己发的消息，
+ * 以及任何显式关闭的本子树），SpanStyle 和自绘都不会挂，渲染路径与没这个功能时一模一样。
+ */
+@Composable
+internal fun quoteStyleOrNull(selfDrawn: Boolean = false): QuoteStyle? {
+    // 用户消息不走这条路径：连颜色都不算，直接当作「功能关闭」
+    if (!LocalQuoteStyleEnabled.current) return null
+    val displaySetting = LocalSettings.current.displaySetting
+    if (!displaySetting.enableQuoteHighlight) return null
+    val colorScheme = MaterialTheme.colorScheme
+    // 正文字号：「符号大小」倍率的基准（倍率 1.0x 时不使用，见 resolveOuterFontSize()）
+    val baseFontSize = LocalTextStyle.current.fontSize
+    // 默认跟随「正文色」：老版本这里是 tertiary（第三强调色），在浅色主题下会推出一个
+    // 偏紫的灰，对白、下划线、行首竖线一起变紫，跟正文完全脱节。
+    // 改成 onSurface 后，没自己选色时对白和正文同色，看齐的是平时阅读的观感；
+    // 想区分就自己去挑颜色，底色 / 下划线 / 竖线都还照旧能拉开层次。
+    val themeQuoteColor =
+        if (colorScheme.onSurface == Color.Unspecified) colorScheme.primary else colorScheme.onSurface
+    val textColor = displaySetting.quoteHighlightColor?.let { Color(it) } ?: themeQuoteColor
+    val backgroundAlpha = displaySetting.quoteHighlightBackgroundAlpha.coerceIn(0f, 1f)
+    // 底色要三道关：底色总开关打开 + 选了颜色 + 透明度大于 0，否则一律当作「不加底色」
+    val backgroundColor = displaySetting.quoteHighlightBackground
+        ?.takeIf { displaySetting.quoteBackgroundEnabled }
+        ?.let { Color(it) }
+        ?.takeIf { backgroundAlpha > 0f }
+        ?.copy(alpha = backgroundAlpha)
+    return QuoteStyle(
+        color = textColor,
+        background = backgroundColor,
+        // 下划线：两个开关各读各的，颜色各自读各自的字段（null = 跟随文字色）
+        solidUnderline = displaySetting.quoteUnderlineSolid,
+        solidUnderlineColor = displaySetting.quoteUnderlineSolidColor?.let { Color(it) },
+        dashedUnderline = displaySetting.quoteUnderlineDashed,
+        dashedUnderlineColor = displaySetting.quoteUnderlineDashedColor?.let { Color(it) },
+        dottedUnderline = displaySetting.quoteUnderlineDotted,
+        dottedUnderlineColor = displaySetting.quoteUnderlineDottedColor?.let { Color(it) },
+        leadingBar = displaySetting.quoteLeadingBar,
+        // 行首竖线用自己的颜色，不再借用下划线颜色
+        leadingBarColor = displaySetting.quoteLeadingBarColor?.let { Color(it) },
+        // 行首竖线的高度比例（0.3x..1.2x）与左右位置（-4dp..8dp）
+        leadingBarHeightScale = displaySetting.quoteBarHeightScale.coerceIn(
+            MIN_BAR_HEIGHT_SCALE, MAX_BAR_HEIGHT_SCALE
+        ),
+        leadingBarOffsetDp = displaySetting.quoteBarOffsetDp.coerceIn(
+            MIN_BAR_OFFSET_DP, MAX_BAR_OFFSET_DP
+        ),
+        // 行首竖线粗细（1dp..5dp，默认 2dp）
+        quoteBarWidthDp = displaySetting.quoteBarWidthDp.coerceIn(
+            MIN_BAR_WIDTH_DP, MAX_BAR_WIDTH_DP
+        ),
+        backgroundCorner = displaySetting.quoteBackgroundCorner.coerceIn(0, 64),
+        // 「整段上下的内缩」不再参与行间留白（行间永远无缝），只在首行之上 / 末行之下生效
+        backgroundGap = displaySetting.quoteBackgroundGap.coerceIn(0, 24),
+        // 「下划线与文字的距离」滑块（0..10dp）与「虚线与点线的密度」滑块（0.2x..3.0x，越大越密）
+        underlineOffset = displaySetting.quoteUnderlineOffset.coerceIn(0, MAX_UNDERLINE_OFFSET),
+        underlineInsetDp = displaySetting.quoteUnderlineInsetDp.coerceIn(0, 12),
+        dashScale = displaySetting.quoteDashScale.coerceIn(MIN_DASH_DENSITY, MAX_DASH_DENSITY),
+        // 外层符号：枚举 → 实际字符。NONE 时开闭都是空串，appendQuotedText 一个字符都不插
+        outerOpen = displaySetting.quoteOuterDecor.openSymbol(),
+        outerClose = displaySetting.quoteOuterDecor.closeSymbol(),
+        outerSpace = displaySetting.quoteOuterDecorSpace.coerceIn(MIN_OUTER_SPACE, MAX_OUTER_SPACE),
+        outerFollowHighlight = displaySetting.quoteOuterDecorFollowHighlight,
+        // 「符号大小」倍率 × 正文字号 = 符号自己的字号；倍率 1.0x（或拿不到正文字号）时给
+        // Unspecified，等价于「不给符号设字号」，默认状态下与老版本逐像素一致。
+        outerFontSize = resolveOuterFontSize(displaySetting.quoteOuterDecorScale, baseFontSize),
+        // 外层符号单独指定字体：打开就用系统默认字体（≈ 手机原生的「」），否则跟随正文
+        outerFontFamily = if (displaySetting.quoteOuterDecorSystemFont) FontFamily.Default else null,
+        selfDrawn = selfDrawn,
+    )
+}
+
+/**
+ * 给独立渲染的文本节点用（不走 AnnotatedString 段落的那几条分支）。
+ * 每条消息只算一次：key 是文本 + 整个 [QuoteStyle]（文字色 / 底色 / 实线虚线开关与各自颜色 / 竖线色都在里面），
+ * 开关关掉时等价于 `AnnotatedString(text)`。
+ */
+@Composable
+internal fun rememberQuotedText(text: String): AnnotatedString {
+    val quoteStyle = quoteStyleOrNull()
+    return remember(text, quoteStyle) {
+        buildAnnotatedString { appendQuotedText(text = text, quoteStyle = quoteStyle) }
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// 自绘：行级底色 / 下划线（实线 · 虚线 · 点线）/ 行首竖线
+// ---------------------------------------------------------------------------------------------
+
+/**
+ * `TextLayoutResult` 的持有者。
+ *
+ * `Text` 的 `onTextLayout` 回调里写、`drawBehind` 的绘制阶段读：只登记读在绘制阶段，
+ * 所以布局结果变化只会让绘制失效，不会反过来触发重组（避免「重组 → 重新布局 → 再写状态」的打转）。
+ */
+internal class QuoteLayoutHolder {
+    var layout: TextLayoutResult? by mutableStateOf(null)
+}
+
+/** 每条消息一个 holder（布局结果引用，重排时会被覆盖） */
+@Composable
+internal fun rememberQuoteLayoutHolder(): QuoteLayoutHolder = remember { QuoteLayoutHolder() }
+
+/**
+ * 给 `Text(onTextLayout = ...)` 用：没有要自绘的引号区间时返回 null，
+ * 这时 `Text` 连一次布局回调都不会挂，与改动前的渲染完全一致。
+ */
+@Composable
+internal fun rememberQuoteOnTextLayout(
+    holder: QuoteLayoutHolder,
+    enabled: Boolean,
+): ((TextLayoutResult) -> Unit)? = remember(holder, enabled) {
+    if (enabled) {
+        { result: TextLayoutResult -> holder.layout = result }
+    } else {
+        null
+    }
+}
+
+/**
+ * 虚线 / 点线**密度**滑块的下限（0.2x，也就是"最稀"），和设置页滑块范围一致。
+ * 注意这里是「密度」：代码里乘的是 `1f / 密度`，所以 0.2 表示 dash 段放大 5 倍（最稀）。
+ */
+private const val MIN_DASH_DENSITY = 0.2f
+
+/** 虚线 / 点线密度滑块的上限（3.0x，也就是"最密"）：dash 段缩到原来的三分之一 */
+private const val MAX_DASH_DENSITY = 3.0f
+
+/** 下划线与文字距离滑块的上限（dp），和设置页的滑块范围一致 */
+private const val MAX_UNDERLINE_OFFSET = 10
+
+/** 行首竖线高度比例的下限 / 上限（0.3x..1.2x），和设置页滑块范围一致 */
+private const val MIN_BAR_HEIGHT_SCALE = 0.3f
+private const val MAX_BAR_HEIGHT_SCALE = 1.2f
+
+/** 行首竖线左右位置的下限 / 上限（dp），和设置页滑块范围一致 */
+private const val MIN_BAR_OFFSET_DP = -8
+private const val MAX_BAR_OFFSET_DP = 4
+
+/** 行首竖线粗细的下限 / 上限（dp），和设置页滑块范围一致 */
+private const val MIN_BAR_WIDTH_DP = 0.1f
+private const val MAX_BAR_WIDTH_DP = 8f
+
+/**
+ * 下划线终点的微收量（dp）。
+ *
+ * 端点一律用 `getHorizontalPosition()` 取（那是**光标**位置 = 字符的 advance 右边缘），
+ * 但闭引号这类全宽标点的 advance 盒本来就比墨迹宽一点点，再加上抗锯齿，
+ * 线看起来还是会压到 / 越过引号右边缘一丝。所以整体再往里收 0.5dp：
+ * 用户截图里「右端还是会长出引号一点」就靠这个微收兜住。
+ */
+private const val UNDERLINE_END_SHRINK_DP = 0.5f
+
+/**
+ * 虚线的「线长 / 空档」：基准 **2dp 线 + 1.5dp 空档**（早先是 3dp/2dp，用户仍嫌稀，再压一格），
+ * 再整体乘上 [multiplier]，最后按屏幕密度折算成 px，避免高密度屏上糊成实线。
+ *
+ * [multiplier] 是**代码侧**的乘数，由 [quoteDecoration] 用 `1f / 设置页密度值` 算出来：
+ * 设置页滑块调大 = 密度变大 = 这里的乘数变小 = dash 段更短更密（语义不是"疏密倍数"，别搞反）。
+ * 只有虚线下划线用得到，实线是纯 Path（不带 PathEffect）。
+ */
+private fun dashedPathEffect(density: Density, multiplier: Float): PathEffect {
+    val unit = density.density * multiplier
+    return PathEffect.dashPathEffect(floatArrayOf(2f * unit, 1.5f * unit))
+}
+
+/**
+ * 点线的「线长 / 空档」：基准 **1dp 点 + 1.2dp 空档**（早先是 1dp/1.5dp），同样乘 [multiplier]，
+ * 折算成 px 后看上去就是一串小点。只有点线下划线用得到。
+ */
+private fun dottedPathEffect(density: Density, multiplier: Float): PathEffect {
+    val unit = density.density * multiplier
+    return PathEffect.dashPathEffect(floatArrayOf(1f * unit, 1.2f * unit))
+}
+
+/**
+ * 对白样式的自绘装饰层。
+ *
+ * 挂在 `Text` 的 `Modifier` 上，用 [TextLayoutResult] 的**行 API** 逐行算几何
+ * （不再拿字符 `getBoundingBox` 去猜整行的左右边界——行首是标点 / 空白，或者区间跨行时，
+ * 首字符的包围盒会窄成一条线甚至量到别的行上，那一行就整块漏画，用户看到的就是「同一段对白里
+ * 中间几行没有底色」）。
+ *
+ * - **区间先合并**：进来的 [ranges] 已经过 [mergeTouchingRanges] 处理，同一行里
+ *   「开引号 + 正文 + 闭引号」是一整段（不然会被画成好几个各带 2dp 内缩的矩形，中间露缝）；
+ * - **起止行**：`getLineForOffset(rangeStart)` / `getLineForOffset(rangeEnd - 1)`，
+ *   然后 `for (line in firstLine..lastLine)` 逐行处理，跨多行时每一行都必然被画到；
+ * - **底色**：每行的上下边界取 `getLineTop(line)` / `getLineBottom(line)` 后**上下各内缩
+ *   `backgroundGap / 2`**（默认 2dp），所以行与行之间仍然留白；**同一行只画一个圆角矩形**，
+ *   引号和正文共用同一块（区间已在入口合并，不会再被切成两段）；
+ *   左右各内缩 2dp，圆角统一取 `backgroundCorner`；
+ *   左右边界取「该行内被区间覆盖的字符子区间」= `max(rangeStart, getLineStart(line))` ..
+ *   `min(rangeEnd, getLineEnd(line))`，再对这个子区间用 `getHorizontalPosition(..., usePrimaryDirection = false)`
+ *   算 x 范围（首字符的 x 当左边、末字符的右边缘当右边，兜底再和 `getBoundingBox` 取一次 min/max）；
+ *   子区间为空（这一行没有引号字符，属于跨行延续 / 空行）**仍然铺满**（用户要的是底色连续），
+ *   但铺的范围不再是整行宽度 `getLineLeft(line)` .. `getLineRight(line)`，而是**首行算出来的
+ *   left / right**（整段共用一对左右界），所以跨行底色不会从右边支出去、也不会比首行更宽；
+ * - **下划线：整段一次性画，而且只画「这一行真被区间覆盖到的字符」**。实线 / 虚线 / 点线
+ *   **各自一个独立的 [Path]**（不共用），把各行的 `moveTo(left, y)` / `lineTo(right, y)` 攒在同一个
+ *   Path 里，最后各 `drawPath(..., style = Stroke(...))` 一次。早先是每行 `drawLine` + `pathEffect`，
+ *   每行的 dash 相位都从 0 重新开始、每行长度又不一样，看上去一段长一段短；现在整段共用一条连续路径
+ *   + 一个 PathEffect，相位连续、dash 长度均匀：
+ *   - **左右端点只取该行被区间覆盖的字符区间**：起点 = `max(rangeStart, getLineStart(line))`、
+ *     终点 = `min(rangeEnd, getLineEnd(line, visibleEnd = true))`，两端的 x **一律**用
+ *     `getHorizontalPosition(offset, usePrimaryDirection = false)` 取（那是光标位置 = 字符 advance 边缘），
+ *     **不再用末字符 `getBoundingBox(...).right`**（含字形右侧留白，会越过闭引号 1~2dp，用户截图确认）；
+ *     终点再往里收 0.5dp，保证线不越过引号右边缘；**算出来长度 <= 0 就这一行不画线**，
+ *     绝不退化成 `getLineLeft` .. `getLineRight` 铺满整行——早先「下划线伸到行末、超出引号」就是那个铺满兜底造成的；
+ *   - y 起点 = `getLineBaseline(line) + underlineOffset.dp`，之后每多开一条再往下错 2dp
+ *     （实线 → 虚线 → 点线），三条全开就是三条分开的线，互不重叠；
+ *   - 实线：不带 `PathEffect`，颜色 `solidUnderlineColor ?: 文字色`；
+ *   - 虚线：`dashPathEffect(2dp * m, 1.5dp * m)`，`m = 1f / dashScale`，颜色 `dashedUnderlineColor ?: 文字色`；
+ *   - 点线：`dashPathEffect(1dp * m, 1.2dp * m)`，`m = 1f / dashScale`，颜色 `dottedUnderlineColor ?: 文字色`；
+ * - **行首竖线（紧贴开引号的那一小段）**：x 取区间起点（也就是**开引号字符**）的
+ *   `getBoundingBox(rangeStart).left` 加上「竖线左右位置」`leadingBarOffsetDp`（默认 0，
+ *   比早先写死的 2dp 更贴字；范围 -4..8dp），所以竖线就在引号左边，不会跑到行首、
+ *   更不会落在段落左边缘（不 clamp 到 `getLineLeft`，引号在行中间时也照样贴着引号）；
+ *   高度 = 该行行高 × `leadingBarHeightScale`（默认 0.7x，范围 0.3x..1.2x），**以行中心为基准居中**，
+ *   不再是整行顶天立地；仍然**只覆盖开引号所在那一行**，跨行对白**不**往下延伸；
+ *   宽度取「竖线粗细」滑块（`quoteBarWidthDp`，0.1..8dp 连续，默认 2dp）、圆角 1dp，
+ *   颜色 `leadingBarColor ?: 文字色`；
+ * - **层序**：底色（Path 填充）在最底层 → 下划线（三条 Path）→ 行首竖线在最上层，
+ *   三层互相独立、可以同时开启；竖线最后画，所以它永远压在底色之上；
+ * - 绘制阶段不拼字符串、不建集合：区间是组合期算好的 IntArray，`PathEffect` 在组合期 remember，
+ *   `Offset` / `Size` / `CornerRadius` / `Rect` 都是 value class；每段区间最多新建 4 个 Path。
+ *
+ * `quoteRanges` 为空（没引号 / 关闭自绘 / 用户消息）时调用方根本不会挂这个 Modifier。
+ */
+@Composable
+internal fun Modifier.quoteDecoration(
+    style: QuoteStyle,
+    text: String,
+    ranges: IntArray,
+    holder: QuoteLayoutHolder,
+): Modifier {
+    val density = LocalDensity.current
+    // 设置页滑块是「密度」：数值越大越密，所以代码里乘的是倒数（1f / 密度）
+    val dashDensity = style.dashScale.coerceIn(MIN_DASH_DENSITY, MAX_DASH_DENSITY)
+    val dashMultiplier = 1f / dashDensity
+    // 只有开了对应开关才去算 PathEffect；实线不带任何 PathEffect。
+    // 密度也进 key：拖动滑块时新的 PathEffect 才会生效
+    val dashedEffect = remember(style.dashedUnderline, dashMultiplier, density) {
+        if (style.dashedUnderline) dashedPathEffect(density, dashMultiplier) else null
+    }
+    val dottedEffect = remember(style.dottedUnderline, dashMultiplier, density) {
+        if (style.dottedUnderline) dottedPathEffect(density, dashMultiplier) else null
+    }
+    // 行首竖线：高度比例（0.3x..1.2x）与左右位置（-4dp..8dp），都在组合期折算成 px
+    val barHeightScale = style.leadingBarHeightScale
+        .coerceIn(MIN_BAR_HEIGHT_SCALE, MAX_BAR_HEIGHT_SCALE)
+    val barOffsetPx = with(density) {
+        style.leadingBarOffsetDp.coerceIn(MIN_BAR_OFFSET_DP, MAX_BAR_OFFSET_DP).dp.toPx()
+    }
+    // 行与行之间的留白（每行上下各取一半），默认 2dp；同一行内的引号与正文已经合并成一整段
+    val gapPx = with(density) { style.backgroundGap.dp.toPx() }
+    val halfGapPx = gapPx / 2f
+    val cornerPx = with(density) { style.backgroundCorner.dp.toPx() }
+    // 「下划线与文字的距离」滑块：baseline 往下偏移多少 dp 才是第一条线的位置
+    val underlineOffsetPx =
+        with(density) { style.underlineOffset.coerceIn(0, MAX_UNDERLINE_OFFSET).dp.toPx() }
+    // 下划线终点微收（0.5dp）：端点用光标位置取，再往里收一点，保证线不越过闭引号右边缘
+    val underlineEndShrinkPx = with(density) { UNDERLINE_END_SHRINK_DP.dp.toPx() }
+    // 行首竖线粗细（1..5dp，默认 2dp）：drawRoundRect 的 width
+    val barWidthPx = with(density) {
+        style.quoteBarWidthDp.coerceIn(MIN_BAR_WIDTH_DP, MAX_BAR_WIDTH_DP).dp.toPx()
+    }
+
+    return this.drawBehind {
+        val layoutResult = holder.layout ?: return@drawBehind
+        if (ranges.size < 2 || layoutResult.lineCount <= 0) return@drawBehind
+
+        val backgroundColor = style.background
+        // 三条线三套颜色：没单选颜色就各自跟随文字色
+        val solidColor = style.solidUnderlineColor ?: style.color
+        val dashedColor = style.dashedUnderlineColor ?: style.color
+        val dottedColor = style.dottedUnderlineColor ?: style.color
+        val barColor = style.leadingBarColor ?: style.color
+        val horizontalInset = 2.dp.toPx()
+        val strokeWidth = 1.dp.toPx()
+        // 多条下划线同时打开时，每多一条就再往下让 2dp（实线 → 虚线 → 点线），不会糊在一起
+        val lineStep = 2.dp.toPx()
+        // 行首竖线粗细：取「竖线粗细」滑块（1..5dp，默认 2dp）
+        val barWidth = barWidthPx
+        // 竖线紧贴开引号字符：x = 开引号包围盒左边缘 - 「竖线左右位置」滑块（不 clamp，引号在行中间也贴着引号）
+        val barCorner = CornerRadius(1.dp.toPx())
+        val corner = CornerRadius(cornerPx)
+        val textLength = text.length
+        val drawSolid = style.solidUnderline
+        val drawDashed = style.dashedUnderline && dashedEffect != null
+        val drawDotted = style.dottedUnderline && dottedEffect != null
+        val drawBar = style.leadingBar
+
+        var index = 0
+        while (index + 1 < ranges.size) {
+            val rangeStart = ranges[index].coerceIn(0, textLength)
+            val rangeEnd = ranges[index + 1].coerceIn(rangeStart, textLength)
+            index += 2
+            if (rangeEnd <= rangeStart) continue
+
+            // 起止行：用行 API 定位，区间跨几行就处理几行，绝不靠字符包围盒去猜
+            val firstLine = layoutResult.getLineForOffset(rangeStart)
+            val lastLine = layoutResult.getLineForOffset(rangeEnd - 1)
+            if (lastLine < firstLine) continue
+
+            // 三条下划线各自一条 Path（互不共用），整段攒完各画一次
+            val solidPath = if (drawSolid) Path() else null
+            val dashedPath = if (drawDashed) Path() else null
+            val dottedPath = if (drawDotted) Path() else null
+
+            // 整段的左右界：先用**首行**真正被区间覆盖到的字符算一次，后面的行（跨行延续 / 只有空白的
+            // 行）就按这一对 left / right 铺底色，所以底色连续但不会超出首行的左右边界。
+            // 先按首行整行兜底，首行真有字符时再用字符区间覆盖（绘制阶段不建临时对象，所以不用 Pair）。
+            var segmentLeft = layoutResult.getLineLeft(firstLine)
+            var segmentRight = layoutResult.getLineRight(firstLine)
+            val firstSegStart = maxOf(rangeStart, layoutResult.getLineStart(firstLine))
+            var firstSegEnd = minOf(rangeEnd, layoutResult.getLineEnd(firstLine))
+            while (firstSegEnd > firstSegStart && text[firstSegEnd - 1].isWhitespace()) {
+                firstSegEnd--
+            }
+            if (firstSegEnd > firstSegStart) {
+                val headX = layoutResult.getHorizontalPosition(firstSegStart, usePrimaryDirection = false)
+                val tailX = layoutResult.getHorizontalPosition(
+                    firstSegEnd.coerceAtMost(textLength), usePrimaryDirection = false
+                )
+                val tailBox = layoutResult.getBoundingBox(firstSegEnd - 1)
+                val segL = minOf(headX, tailBox.left)
+                val segR = maxOf(tailX, tailBox.right)
+                if (segR > segL) {
+                    segmentLeft = segL
+                    segmentRight = segR
+                }
+            }
+
+            var line = firstLine
+            while (line <= lastLine) {
+                val lineTop = layoutResult.getLineTop(line)
+                val lineBottom = layoutResult.getLineBottom(line)
+                val lineStartOffset = layoutResult.getLineStart(line)
+                val lineEndOffset = layoutResult.getLineEnd(line)
+                // 行尾「可见」结束位置（visibleEnd = true，不含换行符）：下划线终点用它，
+                // 否则跨行时 min(rangeEnd, lineEnd) 会落在换行符之后、x 掉到下一行行首
+                val visibleLineEnd = layoutResult.getLineEnd(line, visibleEnd = true)
+                // 该行内被区间覆盖的字符子区间
+                val rawStart = maxOf(rangeStart, lineStartOffset)
+                val rawEnd = minOf(rangeEnd, lineEndOffset)
+                // 行尾的空白（含换行符）不算进底色 / 下划线，否则会被尾随空格 / 换行拉长一截
+                var segStart = rawStart
+                var segEnd = rawEnd
+                while (segEnd > segStart && text[segEnd - 1].isWhitespace()) {
+                    segEnd--
+                }
+
+                // 这一行**真正被区间覆盖到的字符**的左右边界：只有这里才画下划线。
+                // 区间为空（跨行延续 / 行末 / 空行）时 hasCharSpan = false，下划线直接跳过，
+                // 绝不退化成 getLineLeft..getLineRight 铺满整行（那就是「下划线超出引号」的元凶）。
+                var lineLeft = 0f
+                var lineRight = 0f
+                // 字形级的左右界：只取字符自己的轮廓（getBoundingBox），不用光标位置。
+                // 光标位置（getHorizontalPosition）会带上字符间距，画出来的线就比文字宽一截，
+                // 于是「线跑到引号外面」—— 底色的宽松界用它，下划线必须用这个紧界。
+                var glyphLeft = 0f
+                var glyphRight = 0f
+                // 整行都落在引号里（极短的引号单独成行）时为 false，这一行下划线直接跳过
+                var hasGlyphSpan = false
+                var hasCharSpan = false
+                if (segEnd > segStart) {
+                    val headX = layoutResult.getHorizontalPosition(segStart, usePrimaryDirection = false)
+                    val tailX = layoutResult.getHorizontalPosition(
+                        segEnd.coerceAtMost(textLength), usePrimaryDirection = false
+                    )
+                    val tailBox = layoutResult.getBoundingBox(segEnd - 1)
+                    lineLeft = minOf(headX, tailBox.left)
+                    lineRight = maxOf(tailX, tailBox.right)
+                    hasCharSpan = lineRight > lineLeft
+
+                    // 下划线专用的紧界：取区间首尾字符的字形轮廓（比光标位置更贴身，
+                    // 光标位置带字符间距，画出来会往引号外面探出一截）
+                    val uStart = segStart
+                    val uEnd = segEnd
+                    if (uEnd > uStart) {
+                        val headBox = layoutResult.getBoundingBox(uStart)
+                        val endBox = layoutResult.getBoundingBox(uEnd - 1)
+                        // 空字形（空格 / 某些标点）宽度是 0，这时退回光标位置，绝不画成一个点
+                        glyphLeft = if (headBox.width > 0f) {
+                            headBox.left
+                        } else {
+                            layoutResult.getHorizontalPosition(uStart, usePrimaryDirection = false)
+                        }
+                        glyphRight = if (endBox.width > 0f) {
+                            endBox.right
+                        } else {
+                            layoutResult.getHorizontalPosition(uEnd, usePrimaryDirection = false)
+                        }
+                        hasGlyphSpan = glyphRight > glyphLeft
+                    }
+                }
+
+                // 底色的左右界：有真字符就用这一行的字符区间；跨行延续 / 空行仍然铺满，
+                // 但铺的是首行算出的 segmentLeft..segmentRight（不再用整行宽度，右边不会支出去）
+                val bgLeft: Float
+                val bgRight: Float
+                if (hasCharSpan) {
+                    bgLeft = lineLeft
+                    bgRight = lineRight
+                } else if (line < lastLine) {
+                    // 这一行没有任何真正的引号字符（跨行延续 / 中间的空行 / 整行空白）→ 按首行左右界铺满，
+                    // 「同一段对白里中间几行没有底色」的 bug 就是在这里补上的
+                    bgLeft = segmentLeft
+                    bgRight = segmentRight
+                } else if (rawEnd > rawStart) {
+                    // 末行只剩标点后的空白 / 换行：按未裁剪的原始子区间画，不去铺满整行
+                    val headX = layoutResult.getHorizontalPosition(rawStart, usePrimaryDirection = false)
+                    val tailX = layoutResult.getHorizontalPosition(
+                        rawEnd.coerceAtMost(textLength), usePrimaryDirection = false
+                    )
+                    bgLeft = minOf(headX, tailX)
+                    bgRight = maxOf(headX, tailX)
+                } else {
+                    // 最后一行且区间不覆盖这一行的任何字符：这一行什么都不画
+                    line++
+                    continue
+                }
+
+
+                // 行与行之间仍然留白：每行上下各内缩 backgroundGap / 2（默认 2dp）；
+                // 同一行里引号和正文已经合并（见 mergeTouchingRanges），所以这一行只画一块
+                val rowTop = lineTop + halfGapPx
+                val rowBottom = lineBottom - halfGapPx
+                // 这一行底色 / 下划线共用的左右界：和底色块完全一致，下划线永远不会比底色宽
+                val spanLeft = bgLeft + horizontalInset
+                val spanRight = bgRight - horizontalInset
+                if (rowBottom > rowTop && spanRight > spanLeft && backgroundColor != null) {
+                    // ① 底色：这一行一块圆角矩形（引号和正文共用同一块，见 mergeTouchingRanges）
+                    drawRoundRect(
+                        color = backgroundColor,
+                        topLeft = Offset(spanLeft, rowTop),
+                        size = Size(spanRight - spanLeft, rowBottom - rowTop),
+                        cornerRadius = corner,
+                    )
+                }
+                // ② 下划线：端点**一律**用 getHorizontalPosition（光标位置）取，
+                //    **不再**用 `getBoundingBox(...).right` —— 包围盒含字形右侧留白，会多出 1~2dp，
+                //    用户截图里「右端还是会长出引号一点」就是它。
+                //    起点 = max(rangeStart, lineStart) 的位置，终点 = min(rangeEnd, lineEnd) 的位置再 -0.5dp；
+                //    lineEnd 取 visibleEnd = true（不含行尾换行符），否则跨行时终点会掉到下一行的 x = 0 上。
+                //    算出来长度 <= 0 的行这一行不画。
+                //    y 起点 = baseline + 「下划线与文字的距离」滑块值，之后每条再往下错 2dp。
+                if (solidPath != null || dashedPath != null || dottedPath != null) {
+                    // 下划线用自己的「字形紧界」，不再复用底色块（底色左右各内缩 2dp 留白，
+                    // 复用会把线收得比文字还窄，用户看到「线跟文字没对齐」就是这里）。
+                    val underlineInsetPx =
+                        with(density) { style.underlineInsetDp.coerceIn(0, 12).dp.toPx() }
+                    // 内缩**只作用在这一整段的两个端头**（开引号那一行 / 闭引号那一行），
+                    // 中间跨行的行首行尾一律不动 —— 这样调滑块只会把两头收进引号里，
+                    // 不会让中间每一行都跟着变窄。0 = 贴着字形不额外收。
+                    val startInsetPx = if (line == firstLine) underlineInsetPx else 0f
+                    val endInsetPx = if (line == lastLine) underlineInsetPx else 0f
+                    val underlineLeft = glyphLeft + startInsetPx
+                    val underlineRight = glyphRight - endInsetPx
+                    run {
+                        if (hasGlyphSpan && underlineRight - underlineLeft > 0f) {
+                            val baseY = layoutResult.getLineBaseline(line) + underlineOffsetPx
+                            var slot = 0
+                            if (solidPath != null) {
+                                val y = baseY + lineStep * slot
+                                slot++
+                                solidPath.moveTo(underlineLeft, y)
+                                solidPath.lineTo(underlineRight, y)
+                            }
+                            if (dashedPath != null) {
+                                val y = baseY + lineStep * slot
+                                slot++
+                                dashedPath.moveTo(underlineLeft, y)
+                                dashedPath.lineTo(underlineRight, y)
+                            }
+                            if (dottedPath != null) {
+                                val y = baseY + lineStep * slot
+                                dottedPath.moveTo(underlineLeft, y)
+                                dottedPath.lineTo(underlineRight, y)
+                            }
+                        }
+                    }
+                }
+                line++
+            }
+
+            // 下划线：整段各画一次，相位连续 → dash 长度均匀；实线不带 PathEffect
+            if (solidPath != null) {
+                drawPath(
+                    path = solidPath,
+                    color = solidColor,
+                    style = Stroke(width = strokeWidth, cap = StrokeCap.Butt),
+                )
+            }
+            if (dashedPath != null) {
+                drawPath(
+                    path = dashedPath,
+                    color = dashedColor,
+                    style = Stroke(
+                        width = strokeWidth,
+                        cap = StrokeCap.Butt,
+                        pathEffect = dashedEffect,
+                    ),
+                )
+            }
+            if (dottedPath != null) {
+                drawPath(
+                    path = dottedPath,
+                    color = dottedColor,
+                    style = Stroke(
+                        width = strokeWidth,
+                        cap = StrokeCap.Butt,
+                        pathEffect = dottedEffect,
+                    ),
+                )
+            }
+
+            // ③ 行首竖线：只画**短的一段**，紧贴开引号字符左侧，高度 = 开引号所在那一行的行高 ×
+            //    「竖线高度」比例（默认 0.7x，以行中心居中），所以不再是整行顶天立地；
+            //    跨行对白也不往下延伸（跨行位置不规整，延伸反而会压在别的段落上）；
+            //    放在底色 / 下划线之后画，保证它永远在最上层。
+            if (drawBar) {
+                // x = 开引号字符（区间起点）的包围盒左边缘 - 「竖线左右位置」滑块值（默认 1dp）：
+                // 引号从行中间开始时也贴着引号，不会被拽到行首 / 段落边缘，也不 clamp
+                val quoteBox = layoutResult.getBoundingBox(rangeStart)
+                val charLeft = if (quoteBox.width > 0f) {
+                    quoteBox.left
+                } else {
+                    layoutResult.getHorizontalPosition(rangeStart, usePrimaryDirection = false)
+                }
+                // 负值 = 往左挪开引号，正值 = 往右压进引号（0 = 紧贴引号左边缘）
+                val barX = charLeft + barOffsetPx
+                // 只覆盖开引号所在那一行，不再延伸到整段末尾；
+                // 高度 = 行高 × 「竖线高度」比例（默认 0.7x），以这一行的垂直中心为基准居中
+                val firstLineTop = layoutResult.getLineTop(firstLine)
+                val firstLineBottom = layoutResult.getLineBottom(firstLine)
+                val centerY = (firstLineTop + firstLineBottom) / 2f
+                val barHeight = (firstLineBottom - firstLineTop) * barHeightScale
+                if (barHeight > 0f) {
+                    drawRoundRect(
+                        color = barColor,
+                        topLeft = Offset(barX, centerY - barHeight / 2f),
+                        size = Size(barWidth, barHeight),
+                        cornerRadius = barCorner,
+                    )
+                }
+            }
+        }
+    }
+}

+/**
+ * 输入框 + 面板第四格点开后的装扮选择条。
+ *
+ * 只做「看一眼 + 点一下换」，不做增删改——那些放到 设置 · 装扮 里，
+ * 免得这个面板越堆越长。没存过装扮时给一句提示 + 一个去设置的按钮。
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun DecorPresetPickerSheet(
+    setting: Settings,
+    onApply: (DecorPreset) -> Unit,
+    onManage: () -> Unit,
+    onDismiss: () -> Unit,
+) {
+    val presets = setting.decorPresets
+
+    ModalBottomSheet(onDismissRequest = onDismiss) {
+        Column(
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(bottom = 16.dp),
+            verticalArrangement = Arrangement.spacedBy(12.dp),
+        ) {
+            Text(
+                text = "装扮",
+                style = MaterialTheme.typography.titleMedium,
+                modifier = Modifier.padding(horizontal = 16.dp),
+            )
+
+            if (presets.isEmpty()) {
+                Box(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = 16.dp, vertical = 24.dp),
+                    contentAlignment = Alignment.Center,
+                ) {
+                    Column(
+                        horizontalAlignment = Alignment.CenterHorizontally,
+                        verticalArrangement = Arrangement.spacedBy(8.dp),
+                    ) {
+                        Text(
+                            text = "还没保存过装扮",
+                            style = MaterialTheme.typography.bodyMedium,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        )
+                        Text(
+                            text = "去「设置 · 装扮」把现在这套存下来，以后一键换回来",
+                            style = MaterialTheme.typography.labelSmall,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        )
+                    }
+                }
+            } else {
+                LazyRow(
+                    modifier = Modifier.fillMaxWidth(),
+                    contentPadding = PaddingValues(horizontal = 16.dp),
+                    horizontalArrangement = Arrangement.spacedBy(10.dp),
+                ) {
+                    items(presets, key = { it.id }) { preset ->
+                        DecorPresetTile(
+                            preset = preset,
+                            currentSetting = setting,
+                            onClick = { onApply(preset) },
+                        )
+                    }
+                }
+            }
+
+            TextButton(
+                onClick = onManage,
+                modifier = Modifier.padding(horizontal = 8.dp),
+            ) {
+                Icon(HugeIcons.Settings02, null)
+                Text(
+                    text = " 管理装扮",
+                    style = MaterialTheme.typography.labelLarge,
+                )
+            }
+        }
+    }
+}

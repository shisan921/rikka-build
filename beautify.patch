index 0000000..cc1ef3a
--- /dev/null
+++ b/app/src/main/java/me/rerere/rikkahub/ui/components/richtext/QuoteHighlight.kt
@@ -0,0 +1,162 @@
+package me.rerere.rikkahub.ui.components.richtext
+
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.text.AnnotatedString
+import androidx.compose.ui.text.SpanStyle
+import androidx.compose.ui.text.buildAnnotatedString
+import androidx.compose.ui.text.withStyle
+import me.rerere.rikkahub.ui.context.LocalSettings
+
+/**
+ * 引号内文字高亮。
+ *
+ * 2.5.3 的 markdown 渲染没有「主题」对象可以配置（`com.github.rikkahub:markdown` 只提供
+ * org.intellij.markdown 的解析器，AST → Compose 的渲染全部在 [Markdown] / [MarkdownNew] 里），
+ * 所以这里不走「把引号内容伪装成别的内联元素」的预处理，直接在渲染层的文本追加点上给引号内的
+ * 那一段文字套一个 `SpanStyle(color = 引号高亮色)`：
+ *
+ * - 不新增任何 markdown 语法，消息原文不改，复制/导出拿到的还是用户看到的原文；
+ * - 代码天然不受影响：行内代码（CODE_SPAN / `<code>`）和代码块（CODE_FENCE / `<pre>`）在渲染器里
+ *   都有独立分支，文本压根不经过 [appendQuotedText]，不需要正则去跳过 ``` 围栏；
+ * - 关闭开关时 [quoteHighlightColorOrNull] 返回 null，[appendQuotedText] 退化成 `append(text)`，
+ *   与改动前的输出完全一致。
+ */
+
+/** 中文左引号、中文右引号、英文双引号。单引号 / 「」不处理，避免把英文撇号和日式引用一起染上色。 */
+private const val QUOTE_OPEN = '\u201C'   // “
+private const val QUOTE_CLOSE = '\u201D'  // ”
+private const val QUOTE_ASCII = '"'
+
+/**
+ * 纯函数：把一段纯文本按引号切成若干段，标出哪几段在引号内。
+ *
+ * 规则（结果拼起来永远等于入参 [text]，不会有字符丢失）：
+ * 1. `“` 与 `"` 当作开引号，`”` 当作闭引号；已经在引号里时遇到 `“` / `"` 当作闭引号（多引号混用的兜底）；
+ * 2. 引号符号本身和里面的内容一起上色（和常见的对话高亮一致），标点也算在内；
+ * 3. **必须成对出现才高亮**：段落末尾还没闭合的引号（流式输出打了一半 / AI 少打一个引号）整段按普通文本处理，
+ *    不会把后面正文一起染上色；
+ * 4. 没有引号字符时原样返回一段普通文本，零额外开销。
+ */
+internal fun splitQuotedSegments(text: String): List<QuotedTextSegment> {
+    if (text.isEmpty()) return emptyList()
+    val hasQuote = text.any { it == QUOTE_OPEN || it == QUOTE_CLOSE || it == QUOTE_ASCII }
+    if (!hasQuote) return listOf(QuotedTextSegment(text = text, quoted = false))
+
+    val segments = ArrayList<QuotedTextSegment>(8)
+    val buffer = StringBuilder()
+    var inQuote = false
+
+    // 按顺序吐出 buffer 里的内容，绝不改变字符相对位置（拼回去必须和原文一模一样）
+    fun flush(quoted: Boolean) {
+        if (buffer.isNotEmpty()) {
+            segments.add(QuotedTextSegment(text = buffer.toString(), quoted = quoted))
+            buffer.setLength(0)
+        }
+    }
+
+    // 后面还有没有能闭合的引号（流式输出打一半时用来判断这一对是否成立）
+    fun hasCloseAfter(index: Int): Boolean {
+        var i = index + 1
+        while (i < text.length) {
+            val c = text[i]
+            if (c == QUOTE_CLOSE || c == QUOTE_ASCII) return true
+            i++
+        }
+        return false
+    }
+
+    text.forEachIndexed { index, ch ->
+        when (ch) {
+            QUOTE_OPEN, QUOTE_ASCII -> {
+                if (!inQuote) {
+                    if (!hasCloseAfter(index)) {
+                        // 找不到闭合引号：这个符号按普通文本处理，后面的正文不会被染色
+                        buffer.append(ch)
+                    } else {
+                        flush(false)
+                        inQuote = true
+                        // 引号符号本身跟着内容一起上色
+                        segments.add(QuotedTextSegment(text = ch.toString(), quoted = true))
+                    }
+                } else {
+                    flush(true)
+                    inQuote = false
+                    segments.add(QuotedTextSegment(text = ch.toString(), quoted = true))
+                }
+            }
+
+            QUOTE_CLOSE -> {
+                if (inQuote) {
+                    flush(true)
+                    inQuote = false
+                    segments.add(QuotedTextSegment(text = ch.toString(), quoted = true))
+                } else {
+                    buffer.append(ch)
+                }
+            }
+
+            else -> buffer.append(ch)
+        }
+    }
+    // 段尾：没闭合的引号内容按普通文本处理
+    flush(false)
+    return segments
+}
+
+/** [splitQuotedSegments] 的一段结果。[quoted] 为 true 表示这段文字要被上色。 */
+internal data class QuotedTextSegment(
+    val text: String,
+    val quoted: Boolean,
+)
+
+/**
+ * 往 AnnotatedString 里追加一段纯文本，[quoteColor] 非 null 时给引号内的文字套上颜色。
+ *
+ * 只加 color，不动 fontFamily / fontSize / fontStyle，所以外面已有的加粗、斜体、删除线、
+ * 链接、行内公式等样式不会被破坏。
+ */
+internal fun AnnotatedString.Builder.appendQuotedText(text: String, quoteColor: Color?) {
+    if (quoteColor == null) {
+        append(text)
+        return
+    }
+    splitQuotedSegments(text).forEach { segment ->
+        if (segment.quoted) {
+            withStyle(SpanStyle(color = quoteColor)) {
+                append(segment.text)
+            }
+        } else {
+            append(segment.text)
+        }
+    }
+}
+
+/**
+ * 当前这条消息该用的引号高亮色：开关关掉就是 null（渲染路径完全不变）；
+ * 开了但没自己选色就跟随主题的 tertiary 色（tertiary 取不到时退回 primary）。
+ */
+@Composable
+internal fun quoteHighlightColorOrNull(): Color? {
+    val displaySetting = LocalSettings.current.displaySetting
+    if (!displaySetting.enableQuoteHighlight) return null
+    val custom = displaySetting.quoteHighlightColor
+    if (custom != null) return Color(custom)
+    val colorScheme = MaterialTheme.colorScheme
+    // tertiary 是 Material3 的必有槽位，真拿不到（Unspecified）时退回 primary 兜底
+    return if (colorScheme.tertiary == Color.Unspecified) colorScheme.primary else colorScheme.tertiary
+}
+
+/**
+ * 给独立渲染的文本节点用（不走 AnnotatedString 段落的那几条分支）。
+ * 每条消息只算一次：key 是文本 + 颜色，开关关掉时等价于 `AnnotatedString(text)`。
+ */
+@Composable
+internal fun rememberQuotedText(text: String): AnnotatedString {
+    val quoteColor = quoteHighlightColorOrNull()
+    return remember(text, quoteColor) {
+        buildAnnotatedString { appendQuotedText(text = text, quoteColor = quoteColor) }
+    }
+}

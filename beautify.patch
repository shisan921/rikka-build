+/**
+ * 取色盘弹窗：色域方块 + 色相条 + 透明度条 + 原色/当前预览 + HEX 输入 + 记忆色。
+ *
+ * 全部自绘（Canvas + Brush + pointerInput），不依赖 `:ui` 模块里 `internal` 的 SketchColorPicker。
+ * 状态只在弹窗内部滚动，点「确认」才通过 [onConfirm] 写回设置；[onRecentColorsChange] 用于记忆色的
+ * 「+ / 长按删除」，是独立于颜色的设置项，可以立即落库，取消弹窗也不会把刚收藏的颜色弄丢。
+ *
+ * @param title 弹窗标题（即正在改的那一项的名字）
+ * @param initialColor 当前设置里的颜色（ARGB Long），null 表示还没设置
+ * @param fallbackColor 没设置时预览用的主题色
+ * @param recentColors 已保存的记忆色，最近的在前
+ * @param canReset 是否显示「恢复默认」（把颜色置回 null）
+ */
+@Composable
+fun ColorPickerDialog(
+    title: String,
+    initialColor: Long?,
+    fallbackColor: Color,
+    recentColors: List<Long>,
+    onRecentColorsChange: (List<Long>) -> Unit,
+    onDismiss: () -> Unit,
+    onConfirm: (Long) -> Unit,
+    canReset: Boolean = true,
+    onReset: () -> Unit = {},
+) {
+    // 色域里的初始值：设置过就用设置的颜色，没设置就落在主题色上，避免一进来是纯红
+    val baselineArgb: Long = (initialColor ?: (fallbackColor.toArgb().toLong() and 0xFFFFFFFFL)) and 0xFFFFFFFFL
+    val baselineColor = Color(baselineArgb)
+
+    val baselineHsv = remember(baselineArgb) {
+        FloatArray(3).also { AndroidColor.colorToHSV(baselineArgb.toInt(), it) }
+    }
+
+    var hue by remember(baselineArgb) { mutableStateOf(baselineHsv[0]) }
+    var saturation by remember(baselineArgb) { mutableStateOf(baselineHsv[1]) }
+    var brightness by remember(baselineArgb) { mutableStateOf(baselineHsv[2]) }
+    var alphaFraction by remember(baselineArgb) {
+        mutableStateOf(((baselineArgb shr 24) and 0xFFL) / 255f)
+    }
+    // null 表示「跟着色域走」，非 null 表示用户正在手打 HEX，先别覆盖他打的字
+    var hexDraft by remember(baselineArgb) { mutableStateOf<String?>(null) }
+
+    val currentArgb: Long = argbFromHsv(hue, saturation, brightness, alphaFraction)
+    val currentColor = Color(currentArgb)
+    val pureHueColor = Color(argbFromHsv(hue, 1f, 1f, 1f))
+
+    fun applyColorValue(value: Long) {
+        val normalized = value and 0xFFFFFFFFL
+        val hsv = FloatArray(3)
+        AndroidColor.colorToHSV(normalized.toInt(), hsv)
+        // 灰色/黑色没有色相，别把用户刚调好的色相拽回 0
+        if (hsv[1] > 0.0001f && hsv[2] > 0.0001f) hue = hsv[0]
+        saturation = hsv[1]
+        brightness = hsv[2]
+        alphaFraction = ((normalized shr 24) and 0xFFL) / 255f
+    }
+
+    fun applySquarePosition(x: Float, y: Float, width: Int, height: Int) {
+        if (width <= 0 || height <= 0) return
+        saturation = (x / width).coerceIn(0f, 1f)
+        brightness = 1f - (y / height).coerceIn(0f, 1f)
+    }
+
+    fun applyBarPosition(x: Float, width: Int): Float {
+        if (width <= 0) return 0f
+        return (x / width).coerceIn(0f, 1f)
+    }
+
+    // Brush 在组合里建，绘制 lambda 里不建集合
+    val squareHorizontalBrush = remember(pureHueColor) {
+        Brush.horizontalGradient(listOf(Color.White, pureHueColor))
+    }
+    val squareVerticalBrush = remember {
+        Brush.verticalGradient(listOf(Color.Transparent, Color.Black))
+    }
+    val hueBrush = remember {
+        Brush.horizontalGradient(
+            listOf(
+                Color.Red,
+                Color.Yellow,
+                Color.Green,
+                Color.Cyan,
+                Color.Blue,
+                Color.Magenta,
+                Color.Red,
+            )
+        )
+    }
+    val alphaBrush = remember(currentColor) {
+        Brush.horizontalGradient(
+            listOf(
+                currentColor.copy(alpha = 0f),
+                currentColor.copy(alpha = 1f),
+            )
+        )
+    }
+
+    val squareShape = RoundedCornerShape(12.dp)
+    val barShape = RoundedCornerShape(6.dp)
+
+    val draft = hexDraft
+    val hexText = draft ?: currentArgb.toHexArgb()
+    val hexParsed = if (draft != null) parseArgbHex(draft) else currentArgb
+    val hexError = draft != null && draft.isNotBlank() && parseArgbHex(draft) == null
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(title) },
+        text = {
+            Column(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .heightIn(max = 500.dp)
+                    .verticalScroll(rememberScrollState()),
+                verticalArrangement = Arrangement.spacedBy(10.dp),
+            ) {
+                // 1. 色域方块：横轴饱和度、纵轴明度
+                Box(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .height(240.dp)
+                        .clip(squareShape)
+                        .pointerInput(Unit) {
+                            detectTapGestures { offset ->
+                                applySquarePosition(offset.x, offset.y, size.width, size.height)
+                            }
+                        }
+                        .pointerInput(Unit) {
+                            detectDragGestures(
+                                onDragStart = { offset ->
+                                    applySquarePosition(offset.x, offset.y, size.width, size.height)
+                                },
+                                onDrag = { change, _ ->
+                                    change.consume()
+                                    applySquarePosition(
+                                        change.position.x,
+                                        change.position.y,
+                                        size.width,
+                                        size.height,
+                                    )
+                                },
+                            )
+                        },
+                ) {
+                    Canvas(modifier = Modifier.fillMaxSize()) {
+                        drawRect(brush = squareHorizontalBrush)
+                        drawRect(brush = squareVerticalBrush)
+                        val centerX = saturation.coerceIn(0f, 1f) * size.width
+                        val centerY = (1f - brightness.coerceIn(0f, 1f)) * size.height
+                        drawCircle(
+                            color = Color.Black.copy(alpha = 0.3f),
+                            radius = 9.dp.toPx(),
+                            center = Offset(centerX, centerY),
+                            style = Stroke(width = 3.dp.toPx()),
+                        )
+                        drawCircle(
+                            color = Color.White,
+                            radius = 8.dp.toPx(),
+                            center = Offset(centerX, centerY),
+                            style = Stroke(width = 2.dp.toPx()),
+                        )
+                    }
+                }
+
+                // 2. 色相条
+                Box(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .height(14.dp)
+                        .clip(barShape)
+                        .pointerInput(Unit) {
+                            detectTapGestures { offset ->
+                                hue = applyBarPosition(offset.x, size.width) * 360f
+                            }
+                        }
+                        .pointerInput(Unit) {
+                            detectDragGestures(
+                                onDragStart = { offset ->
+                                    hue = applyBarPosition(offset.x, size.width) * 360f
+                                },
+                                onDrag = { change, _ ->
+                                    change.consume()
+                                    hue = applyBarPosition(change.position.x, size.width) * 360f
+                                },
+                            )
+                        },
+                ) {
+                    Canvas(modifier = Modifier.fillMaxSize()) {
+                        drawRect(brush = hueBrush)
+                        val centerX = (hue.coerceIn(0f, 360f) / 360f) * size.width
+                        drawCircle(
+                            color = Color.Black.copy(alpha = 0.3f),
+                            radius = 8.dp.toPx(),
+                            center = Offset(centerX, size.height / 2f),
+                            style = Stroke(width = 3.dp.toPx()),
+                        )
+                        drawCircle(
+                            color = Color.White,
+                            radius = 7.dp.toPx(),
+                            center = Offset(centerX, size.height / 2f),
+                            style = Stroke(width = 2.dp.toPx()),
+                        )
+                    }
+                }
+
+                // 3. 透明度条：底下一层棋盘格，上面叠 alpha 渐变
+                Box(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .height(14.dp)
+                        .clip(barShape)
+                        .pointerInput(Unit) {
+                            detectTapGestures { offset ->
+                                alphaFraction = applyBarPosition(offset.x, size.width)
+                            }
+                        }
+                        .pointerInput(Unit) {
+                            detectDragGestures(
+                                onDragStart = { offset ->
+                                    alphaFraction = applyBarPosition(offset.x, size.width)
+                                },
+                                onDrag = { change, _ ->
+                                    change.consume()
+                                    alphaFraction = applyBarPosition(change.position.x, size.width)
+                                },
+                            )
+                        },
+                ) {
+                    Canvas(modifier = Modifier.fillMaxSize()) {
+                        val cell = 8.dp.toPx()
+                        val columns = ceil(size.width / cell).toInt()
+                        val rows = ceil(size.height / cell).toInt()
+                        val cellSize = Size(cell, cell)
+                        for (row in 0 until rows) {
+                            for (column in 0 until columns) {
+                                val light = (row + column) % 2 == 0
+                                drawRect(
+                                    color = if (light) Color(0xFFEFEFEF) else Color(0xFFBFBFBF),
+                                    topLeft = Offset(column * cell, row * cell),
+                                    size = cellSize,
+                                )
+                            }
+                        }
+                        drawRect(brush = alphaBrush)
+                        val centerX = alphaFraction.coerceIn(0f, 1f) * size.width
+                        drawCircle(
+                            color = Color.Black.copy(alpha = 0.35f),
+                            radius = 8.dp.toPx(),
+                            center = Offset(centerX, size.height / 2f),
+                            style = Stroke(width = 3.dp.toPx()),
+                        )
+                        drawCircle(
+                            color = Color.White,
+                            radius = 7.dp.toPx(),
+                            center = Offset(centerX, size.height / 2f),
+                            style = Stroke(width = 2.dp.toPx()),
+                        )
+                    }
+                }
+
+                // 4. 预览行：原色 → 当前
+                Row(
+                    modifier = Modifier.fillMaxWidth(),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(16.dp),
+                ) {
+                    ColorPreview(label = "原色", color = baselineColor, size = 40.dp)
+                    Text(
+                        text = "→",
+                        style = MaterialTheme.typography.titleMedium,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                    ColorPreview(label = "当前", color = currentColor, size = 40.dp)
+                }
+
+                // 5. HEX 输入：手打立刻同步回色域，失焦后显示规范化后的值
+                OutlinedTextField(
+                    value = hexText,
+                    onValueChange = { input ->
+                        hexDraft = input
+                        parseArgbHex(input)?.let { applyColorValue(it) }
+                    },
+                    singleLine = true,
+                    isError = hexError,
+                    label = { Text("颜色值") },
+                    placeholder = { Text("#AARRGGBB") },
+                    supportingText = {
+                        Text(
+                            if (hexError) {
+                                "格式不对，用 #RRGGBB 或 #AARRGGBB"
+                            } else {
+                                "A 是透明度，FF 为不透明"
+                            }
+                        )
+                    },
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .onFocusChanged { state -> if (!state.isFocused) hexDraft = null },
+                )
+
+                // 6. 记忆色
+                Row(
+                    modifier = Modifier.fillMaxWidth(),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    Text(
+                        text = "记忆色",
+                        style = MaterialTheme.typography.labelLarge,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                    Row(
+                        modifier = Modifier
+                            .weight(1f)
+                            .horizontalScroll(rememberScrollState()),
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.spacedBy(8.dp),
+                    ) {
+                        recentColors.forEach { value ->
+                            Box(
+                                modifier = Modifier
+                                    .size(28.dp)
+                                    .clip(CircleShape)
+                                    .background(Color(value))
+                                    .border(
+                                        width = 1.dp,
+                                        color = MaterialTheme.colorScheme.outlineVariant,
+                                        shape = CircleShape,
+                                    )
+                                    .pointerInput(value) {
+                                        detectTapGestures(
+                                            onTap = {
+                                                applyColorValue(value)
+                                                hexDraft = null
+                                            },
+                                            onLongPress = {
+                                                onRecentColorsChange(recentColors - value)
+                                            },
+                                        )
+                                    },
+                            )
+                        }
+                        Box(
+                            modifier = Modifier
+                                .size(28.dp)
+                                .clip(CircleShape)
+                                .border(
+                                    width = 1.dp,
+                                    color = MaterialTheme.colorScheme.outline,
+                                    shape = CircleShape,
+                                )
+                                .clickable {
+                                    onRecentColorsChange(pushRecentColor(recentColors, currentArgb))
+                                },
+                            contentAlignment = Alignment.Center,
+                        ) {
+                            Text(
+                                text = "+",
+                                style = MaterialTheme.typography.titleMedium,
+                                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                            )
+                        }
+                    }
+                }
+                Text(
+                    text = "点一下取用，长按删除；最多记 12 个",
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    modifier = Modifier.padding(top = 2.dp),
+                )
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = { onConfirm(hexParsed ?: currentArgb) }) {
+                Text("确认")
+            }
+        },
+        dismissButton = {
+            Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                if (canReset) {
+                    TextButton(onClick = onReset) {
+                        Text("恢复默认")
+                    }
+                }
+                TextButton(onClick = onDismiss) {
+                    Text("取消")
+                }
+            }
+        },
+    )
+}
+
+/** 圆形预览色块 + 底下的小标签 */
+@Composable
+private fun ColorPreview(
+    label: String,
+    color: Color,
+    size: androidx.compose.ui.unit.Dp,
+) {
+    Column(horizontalAlignment = Alignment.CenterHorizontally) {
+        Box(
+            modifier = Modifier
+                .size(size)
+                .clip(CircleShape)
+                .background(color)
+                .border(
+                    width = 1.dp,
+                    color = MaterialTheme.colorScheme.outlineVariant,
+                    shape = CircleShape,
+                ),
+        )
+        Text(
+            text = label,
+            style = MaterialTheme.typography.labelSmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(top = 4.dp),
+        )
+    }
+}
+
+/** 记忆色上限 */
+internal const val MAX_RECENT_COLORS = 12
+
+/**
+ * 把 [color] 放到记忆色最前面：去重（同色只留最前面那个）、最多 [MAX_RECENT_COLORS] 个。
+ * 颜色统一按 32 位 ARGB 归一化，避免 `toArgb()` 出来的负数 Int 和正数 Long 被当成两个颜色。
+ */
+internal fun pushRecentColor(recentColors: List<Long>, color: Long): List<Long> {
+    val normalized = color and 0xFFFFFFFFL
+    val result = ArrayList<Long>(MAX_RECENT_COLORS)
+    result.add(normalized)
+    for (item in recentColors) {
+        if (result.size >= MAX_RECENT_COLORS) break
+        val value = item and 0xFFFFFFFFL
+        if (value != normalized) {
+            result.add(value)
+        }
+    }
+    return result
+}
+
+/** HSV + alpha → 0xAARRGGBB */
+internal fun argbFromHsv(hue: Float, saturation: Float, brightness: Float, alpha: Float): Long {
+    val alphaInt = (alpha.coerceIn(0f, 1f) * 255f).roundToInt().coerceIn(0, 255).toLong()
+    val normalizedHue = ((hue % 360f) + 360f) % 360f
+    val rgb = AndroidColor.HSVToColor(
+        floatArrayOf(
+            normalizedHue,
+            saturation.coerceIn(0f, 1f),
+            brightness.coerceIn(0f, 1f),
+        )
+    ).toLong() and 0xFFFFFFL
+    return (alphaInt shl 24) or rgb
+}

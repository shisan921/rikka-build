+/**
+ * 一项可自定义的颜色。[value] 为 null 表示还没设置，[preview] 是没设置时示意用的主题色。
+ */
+private data class ColorField(
+    val title: String,
+    val value: Long?,
+    val preview: Color,
+    val onUpdate: (Long?) -> Unit,
+)
+
+@Composable
+private fun ColorInputDialog(
+    field: ColorField,
+    onDismiss: () -> Unit,
+    onSubmit: (Long?) -> Unit,
+) {
+    var text by remember(field.title) { mutableStateOf(field.value?.toHexArgb().orEmpty()) }
+    val parsed = parseArgbHex(text)
+    val showError = text.isNotBlank() && parsed == null
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(field.title) },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedTextField(
+                    value = text,
+                    onValueChange = { text = it },
+                    singleLine = true,
+                    isError = showError,
+                    label = { Text("颜色值") },
+                    placeholder = { Text("#FF8E4955") },
+                    supportingText = {
+                        Text(
+                            if (showError) {
+                                "格式不对，用 #RRGGBB 或 #AARRGGBB"
+                            } else {
+                                "#RRGGBB 或 #AARRGGBB，留空保持默认"
+                            }
+                        )
+                    },
+                    modifier = Modifier.fillMaxWidth(),
+                )
+                Box(
+                    modifier = Modifier
+                        .size(48.dp)
+                        .clip(MaterialTheme.shapes.medium)
+                        .background(parsed?.let { Color(it) } ?: field.preview),
+                )
+            }
+        },

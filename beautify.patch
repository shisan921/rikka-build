+/**
+ * 一项可自定义的颜色。[value] 为 null 表示还没设置，[preview] 是没设置时示意用的主题色。
+ */
+private data class ColorField(
+    val title: String,
+    val value: Long?,
+    val preview: Color,
+    val onUpdate: (Long?) -> Unit,
+)
+
+@Composable
+private fun ColorInputDialog(
+    field: ColorField,
+    onDismiss: () -> Unit,
+    onSubmit: (Long?) -> Unit,
+) {
+    var text by remember(field.title) { mutableStateOf(field.value?.toHexArgb().orEmpty()) }
+    val parsed = parseArgbHex(text)
+    val showError = text.isNotBlank() && parsed == null
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(field.title) },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedTextField(
+                    value = text,
+                    onValueChange = { text = it },
+                    singleLine = true,
+                    isError = showError,
+                    label = { Text("颜色值") },
+                    placeholder = { Text("#FF8E4955") },
+                    supportingText = {
+                        Text(
+                            if (showError) {
+                                "格式不对，用 #RRGGBB 或 #AARRGGBB"
+                            } else {
+                                "#RRGGBB 或 #AARRGGBB，留空保持默认"
+                            }
+                        )
+                    },
+                    modifier = Modifier.fillMaxWidth(),
+                )
+                Box(
+                    modifier = Modifier
+                        .size(48.dp)
+                        .clip(MaterialTheme.shapes.medium)
+                        .background(parsed?.let { Color(it) } ?: field.preview),
+                )
+            }
+        },
+        confirmButton = {
+            TextButton(
+                // 留空表示不改，格式不对时按钮也不给点，避免把原值改坏
+                enabled = parsed != null || text.isBlank(),
+                onClick = { onSubmit(if (text.isBlank()) field.value else parsed) },
+            ) {
+                Text("确定")
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = { onSubmit(null) }) {
+                Text("恢复默认")
+            }
+        },
+    )
+}
+
+/**
+ * 解析 `#RRGGBB` / `#AARRGGBB`：兼容不带 `#`、`0x` 前缀，3/4 位的简写会按 ARGB 每位重复一次展开。
+ * 解析不出来返回 null，调用方保持原来的值。
+ */
+internal fun parseArgbHex(input: String): Long? {
+    val raw = input.trim()
+        .removePrefix("#")
+        .removePrefix("0x")
+        .removePrefix("0X")
+    if (raw.isEmpty()) return null
+    val hex = when (raw.length) {
+        // 简写每位重复一次：#F80 -> #FF8800
+        3 -> "FF" + raw.map { "$it$it" }.joinToString("")
+        4 -> raw.map { "$it$it" }.joinToString("")
+        6 -> "FF$raw"
+        8 -> raw
+        else -> return null
+    }
+    if (hex.any { it.digitToIntOrNull(16) == null }) return null
+    return hex.toLongOrNull(16)
+}
+
+/** 把 ARGB 拼成 `#AARRGGBB`；alpha 是 FF 时只显示 `#RRGGBB`，方便手动改。 */
+internal fun Long.toHexArgb(): String {
+    val alpha = (this shr 24) and 0xFFL
+    return if (alpha == 0xFFL) {
+        "#%06X".format(Locale.US, this and 0xFFFFFFL)
+    } else {
+        "#%08X".format(Locale.US, this)
+    }
+}

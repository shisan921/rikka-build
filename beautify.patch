+/**
+ * 未缩放的基准排版。
+ *
+ * [Typography] 送进 `MaterialTheme` 之前会按「界面字号」（DisplaySetting.uiFontScale）缩放，
+ * 而消息正文是拿 `LocalTextStyle.current`（= 缩放后的 bodyLarge）当基准的，
+ * 所以正文那一层改用这份没被缩放的排版，保证正文只由自己的字号链路控制。
+ */
+val BaseTypography = Typography()
+
+/**
+ * 界面字号：把整套 Material3 排版（15 个常规槽位 + 15 个 Expressive 强调槽位）的
+ * fontSize / lineHeight / letterSpacing 统一乘上 [scale]。
+ *
+ * - [scale] == 1f 时原样返回 [base]，保证默认状态下逐像素不变；
+ * - 只由 `RikkahubTheme` 调用；消息正文（ChatMessage / Markdown）不经过这里。
+ */
+fun scaledTypography(base: Typography, scale: Float): Typography {
+    if (scale == 1f) return base
+
+    fun TextStyle.scaledBy(): TextStyle = copy(
+        fontSize = if (fontSize.isSpecified) fontSize * scale else fontSize,
+        lineHeight = if (lineHeight.isSpecified) lineHeight * scale else lineHeight,
+        letterSpacing = if (letterSpacing.isSpecified) letterSpacing * scale else letterSpacing,
+    )
+
+    return base.copy(
+        displayLarge = base.displayLarge.scaledBy(),
+        displayMedium = base.displayMedium.scaledBy(),
+        displaySmall = base.displaySmall.scaledBy(),
+        headlineLarge = base.headlineLarge.scaledBy(),
+        headlineMedium = base.headlineMedium.scaledBy(),
+        headlineSmall = base.headlineSmall.scaledBy(),
+        titleLarge = base.titleLarge.scaledBy(),
+        titleMedium = base.titleMedium.scaledBy(),
+        titleSmall = base.titleSmall.scaledBy(),
+        bodyLarge = base.bodyLarge.scaledBy(),
+        bodyMedium = base.bodyMedium.scaledBy(),
+        bodySmall = base.bodySmall.scaledBy(),
+        labelLarge = base.labelLarge.scaledBy(),
+        labelMedium = base.labelMedium.scaledBy(),
+        labelSmall = base.labelSmall.scaledBy(),
+        // Expressive 的强调槽位（CardGroup 标题、头像上的首字母等地方在用），一起缩放才不会有大小断层
+        displayLargeEmphasized = base.displayLargeEmphasized.scaledBy(),
+        displayMediumEmphasized = base.displayMediumEmphasized.scaledBy(),
+        displaySmallEmphasized = base.displaySmallEmphasized.scaledBy(),
+        headlineLargeEmphasized = base.headlineLargeEmphasized.scaledBy(),

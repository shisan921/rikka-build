+            TextButton(
+                // 留空表示不改，格式不对时按钮也不给点，避免把原值改坏
+                enabled = parsed != null || text.isBlank(),
+                onClick = { onSubmit(if (text.isBlank()) field.value else parsed) },
+            ) {
+                Text("确定")
+            }
+        },

+/**
+ * 选择器里的组头：点整行收起 / 展开，右边的开关是**整组总开关**。
+ *
+ * 总开关只在「整组都选中」时显示为开；部分选中时显示为关，点一下就是全选。
+ * 中间那个「已选 / 总数」写清楚，避免误以为一半状态坏了。
+ */
+@Composable
+private fun FolderSelectHeader(
+    label: String,
+    count: Int,
+    selectedCount: Int,
+    collapsed: Boolean,
+    onToggleCollapse: () -> Unit,
+    onToggleAll: (Boolean) -> Unit,
+) {
+    val allSelected = count > 0 && selectedCount == count
+    ListItem(
+        modifier = Modifier.clickable(onClick = onToggleCollapse),
+        headlineContent = {
+            Row(
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.spacedBy(6.dp),
+            ) {
+                Icon(
+                    imageVector = if (collapsed) HugeIcons.ArrowRight01 else HugeIcons.ArrowDown01,
+                    contentDescription = null,
+                    modifier = Modifier.size(18.dp),
+                    tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+                Text(label)
+            }
+        },
+        supportingContent = {
+            Text(
+                text = "$selectedCount / $count",
+                style = MaterialTheme.typography.labelSmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        },
+        trailingContent = {
+            Switch(checked = allSelected, onCheckedChange = onToggleAll)
+        },
+        colors = ListItemDefaults.colors(containerColor = Color.Transparent),
+    )
+}

+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .height(14.dp)
+                        .clip(barShape)
+                        .pointerInput(Unit) {
+                            detectTapGestures { offset ->
+                                hue = applyBarPosition(offset.x, size.width) * 360f
+                            }
+                        }

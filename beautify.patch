+                                )
+                            },
+                        )
+                    }
+                }
+            }
+
+            item {
+                CardGroup(
+                    modifier = Modifier.padding(horizontal = 8.dp),
+                    title = { Text("气泡") },
+                ) {
+                    item(
+                        headlineContent = { Text("气泡圆角") },
+                        supportingContent = {
+                            Column {
+                                Row(
+                                    modifier = Modifier.fillMaxWidth(),
+                                    verticalAlignment = Alignment.CenterVertically,
+                                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                                ) {
+                                    Slider(
+                                        value = displaySetting.bubbleCornerRadius.coerceAtLeast(0).toFloat(),
+                                        onValueChange = {
+                                            updateDisplaySetting(
+                                                displaySetting.copy(bubbleCornerRadius = it.roundToInt())
+                                            )
+                                        },
+                                        valueRange = 0f..48f,
+                                        steps = 47,
+                                        modifier = Modifier.weight(1f)
+                                    )
+                                    Text(
+                                        text = if (displaySetting.bubbleCornerRadius < 0) {
+                                            "默认"
+                                        } else {
+                                            "${displaySetting.bubbleCornerRadius} dp"
+                                        }
+                                    )
+                                }
+                                // 圆角默认值是 -1（比 0 更小），滑块够不到，单独给一个恢复入口
+                                TextButton(
+                                    onClick = {
+                                        updateDisplaySetting(displaySetting.copy(bubbleCornerRadius = -1))
+                                    },
+                                    modifier = Modifier.align(Alignment.End),
+                                ) {
+                                    Text("恢复默认")
+                                }
+                            }
+                        },
+                    )
+                }
+            }
+
+            item {
+                CardGroup(
+                    modifier = Modifier.padding(horizontal = 8.dp),

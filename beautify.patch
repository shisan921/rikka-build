+/** 外层符号选项的中文名：无 / 「」 / 『』 */
+private fun outerDecorLabel(decor: QuoteOuterDecor): String = when (decor) {
+    QuoteOuterDecor.NONE -> "无"
+    QuoteOuterDecor.CORNER -> "「」"
+    QuoteOuterDecor.DOUBLE_CORNER -> "『』"
+}
+
+/**
+ * 「外层符号」当前设置的效果示例，直接显示在这一项的说明里，选完立刻能看到长什么样。
+ *
+ * 间距用**薄空格 U+2009**，和 `QuoteHighlight.appendQuotedText` 渲染时插的是同一个字符；
+ * 大小倍率不在这里放大（示例跟着系统字号走，避免说明文字被撑得忽大忽小）。
+ */
+private fun outerDecorSample(decor: QuoteOuterDecor, space: Int): String {
+    val open = when (decor) {
+        QuoteOuterDecor.NONE -> ""
+        QuoteOuterDecor.CORNER -> "\u300C"
+        QuoteOuterDecor.DOUBLE_CORNER -> "\u300E"
+    }
+    val close = when (decor) {
+        QuoteOuterDecor.NONE -> ""
+        QuoteOuterDecor.CORNER -> "\u300D"
+        QuoteOuterDecor.DOUBLE_CORNER -> "\u300F"
+    }
+    val gap = "\u2009".repeat(space.coerceIn(0, 3))
+    return "$open${gap}\u201C你好。\u201D$gap$close"
+}
+
+/**
+ * 一行「颜色项」：左边标题 + 说明，右边一个圆形色块。
+ *
+ * 直接复用 [CardGroupScope.item]（和页面里其它行同一种卡片排版 / 点击水波），
+ * 色块取当前值，没设置过时用 [ColorField.preview] 这张主题色示意，表示「现在跟随主题 / 文字颜色」。
+ * 抽成扩展函数只是为了让五个颜色行长得完全一样，不重复五份 Box 代码。
+ */
+private fun CardGroupScope.quoteColorItem(
+    field: ColorField,
+    onClick: () -> Unit,
+) {
+    item(
+        onClick = onClick,
+        headlineContent = { Text(field.title) },
+        supportingContent = { Text(field.supporting(field.value)) },
+        trailingContent = {
+            Box(
+                modifier = Modifier
+                    .size(28.dp)
+                    .clip(CircleShape)
+                    .background(field.value?.let { Color(it) } ?: field.preview),
+            )
+        },
+    )
+}

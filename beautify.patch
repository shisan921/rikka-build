+ */
+@Composable
+private fun reasoningContainer(setting: DisplaySetting): Color {
+    val base = setting.assistantBubbleColor?.let { Color(it) }
+        ?: MaterialTheme.colorScheme.surfaceContainerHigh
+    val alpha = (base.alpha * setting.bubbleOpacity * setting.reasoningAlpha).coerceIn(0f, 1f)
+    return base.copy(alpha = alpha)

+                                                        ?.let { Color(it) }
+                                                        ?: MaterialTheme.colorScheme.secondary
+                                                ),
+                                        )
+                                    }
+                                },
+                                headlineContent = { Text(preset.name.ifBlank { "未命名装扮" }) },
+                                supportingContent = { Text(decorPresetSummary(preset)) },
+                                trailingContent = {
+                                    var expanded by remember { mutableStateOf(false) }
+                                    Box {
+                                        IconButton(onClick = { expanded = true }) {
+                                            Icon(HugeIcons.MoreVertical, "更多")
+                                        }
+                                        DropdownMenu(
+                                            expanded = expanded,
+                                            onDismissRequest = { expanded = false },
+                                        ) {
+                                            DropdownMenuItem(
+                                                text = { Text("重命名") },
+                                                leadingIcon = { Icon(HugeIcons.PencilEdit01, null) },
+                                                onClick = {
+                                                    expanded = false
+                                                    nameDialogFor = preset
+                                                    nameDraft = preset.name
+                                                    showNameDialog = true
+                                                },
+                                            )
+                                            DropdownMenuItem(
+                                                text = { Text("用当前样式覆盖这套") },
+                                                leadingIcon = { Icon(HugeIcons.Refresh01, null) },
+                                                onClick = {
+                                                    expanded = false
+                                                    scope.launch {
+                                                        val currentAssistant = settings.assistants
+                                                            .firstOrNull { it.id == settings.assistantId }
+                                                        val captured = DecorPreset.capture(
+                                                            from = current,
+                                                            name = preset.name,
+                                                            themeId = settings.themeId,
+                                                            dynamicColor = settings.dynamicColor,
+                                                            assistantBackground = currentAssistant?.background,
+                                                            assistantBackgroundOpacity = currentAssistant?.backgroundOpacity ?: 1f,
+                                                        ).copy(id = preset.id, createdAt = preset.createdAt)
+                                                        val updated = withContext(Dispatchers.IO) {
+                                                            snapshotDecorImages(context, captured)
+                                                        }
+                                                        savePresets(presets.map {
+                                                            if (it.id == preset.id) updated else it
+                                                        })
+                                                    }
+                                                },
+                                            )
+                                            DropdownMenuItem(
+                                                text = { Text("删除") },
+                                                leadingIcon = { Icon(HugeIcons.Delete02, null) },
+                                                onClick = {
+                                                    expanded = false
+                                                    deleteTarget = preset
+                                                },
+                                            )
+                                        }
+                                    }
+                                },
+                            )
+                        }
+                    }
+                }
+            }
+
+            item {
+                Text(
+                    text = "在输入框的 + 面板里点第四格「装扮」，可以直接横滑切换。",
+                    style = MaterialTheme.typography.labelSmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    modifier = Modifier.padding(horizontal = 16.dp),
+                )
+            }
+        }
+    }
+
+    if (showNameDialog) {
+        AlertDialog(
+            onDismissRequest = { showNameDialog = false },
+            title = { Text(if (nameDialogFor == null) "保存装扮" else "重命名装扮") },
+            text = {
+                OutlinedTextField(
+                    value = nameDraft,
+                    onValueChange = { nameDraft = it },
+                    singleLine = true,
+                    label = { Text("名字") },
+                )
+            },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        val name = nameDraft.trim().ifBlank { "未命名装扮" }
+                        val target = nameDialogFor
+                        if (target == null) {
+                            // 图片先落成这套装扮自己的副本，之后再换图也不会把它带走
+                            scope.launch {
+                                val currentAssistant = settings.assistants
+                                    .firstOrNull { it.id == settings.assistantId }
+                                val captured = DecorPreset.capture(
+                                    from = current,
+                                    name = name,
+                                    themeId = settings.themeId,
+                                    dynamicColor = settings.dynamicColor,
+                                    assistantBackground = currentAssistant?.background,
+                                    assistantBackgroundOpacity = currentAssistant?.backgroundOpacity ?: 1f,
+                                )
+                                val withImages = withContext(Dispatchers.IO) {
+                                    snapshotDecorImages(context, captured)
+                                }
+                                savePresets(presets + withImages)
+                            }
+                        } else {
+                            savePresets(presets.map {
+                                if (it.id == target.id) it.copy(name = name) else it
+                            })
+                        }
+                        showNameDialog = false
+                    }
+                ) { Text("确定") }
+            },
+            dismissButton = {
+                TextButton(onClick = { showNameDialog = false }) { Text("取消") }
+            },
+        )
+    }
+
+    deleteTarget?.let { target ->
+        AlertDialog(
+            onDismissRequest = { deleteTarget = null },
+            title = { Text("删除这套装扮？") },
+            text = { Text("「${target.name.ifBlank { "未命名装扮" }}」会被删掉，当前界面不会变。") },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        scope.launch {
+                            withContext(Dispatchers.IO) { deleteDecorImages(context, target.id) }
+                            savePresets(presets.filterNot { it.id == target.id })
+                        }
+                        deleteTarget = null
+                    }
+                ) { Text("删除") }
+            },
+            dismissButton = {
+                TextButton(onClick = { deleteTarget = null }) { Text("取消") }
+            },
+        )
+    }
+}

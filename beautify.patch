+/**
+ * 气泡配色：设置了自定义颜色就直接用它（自定义值自带 alpha，不再叠加 bubbleOpacity），
+ * 没设置时沿用原来的主题色 + 气泡透明度。
+ */
+@Composable
+private fun userBubbleContainer(setting: DisplaySetting): Color {
+    val custom = setting.userBubbleColor
+    return if (custom != null) {
+        Color(custom)
+    } else {
+        MaterialTheme.colorScheme.primaryContainer.copy(alpha = setting.bubbleOpacity)
+    }
+}
+
+@Composable
+private fun assistantBubbleContainer(setting: DisplaySetting): Color {
+    val custom = setting.assistantBubbleColor
+    return if (custom != null) {
+        Color(custom)
+    } else {
+        MaterialTheme.colorScheme.surfaceContainerHigh.copy(alpha = setting.bubbleOpacity)
+    }
+}
+
+/**
+ * 思维链卡片的底色：跟 AI 气泡共用自定义色，透明度再乘上思维链自己的透明度。
+ */
+@Composable
+private fun reasoningContainer(setting: DisplaySetting): Color {
+    val base = setting.assistantBubbleColor?.let { Color(it) }
+        ?: MaterialTheme.colorScheme.surfaceContainerHigh
+    val alpha = (base.alpha * setting.bubbleOpacity * setting.reasoningAlpha).coerceIn(0f, 1f)
+    return base.copy(alpha = alpha)
+}
+
+/**
+ * 气泡圆角：bubbleCornerRadius >= 0 时用用户设定的值，-1 保持原来的 16dp 圆角。
+ */
+private fun bubbleShape(cornerRadius: Int): RoundedCornerShape {
+    return RoundedCornerShape(if (cornerRadius >= 0) cornerRadius.dp else 16.dp)
+}
+
+/**
+ * 气泡内容色：自定义底色不在主题色板里时 contentColorFor 会返回 Unspecified，
+ * 这时退回外层的内容色；用户明确设了正文文字色时以它为准。
+ */
+@Composable
+private fun bubbleContentColor(setting: DisplaySetting, containerColor: Color): Color {
+    val custom = setting.chatTextColor?.let { Color(it) }
+    val fromTheme = contentColorFor(containerColor)
+    val fallback = if (fromTheme == Color.Unspecified) LocalContentColor.current else fromTheme
+    return custom ?: fallback
+}
+
+/**
+ * 气泡背景图：路径换成 File 并缓存，只有路径变化才重建，绝不每帧 new。
+ * 空字符串（未设置）返回 null，调用方就不画图片层。
+ */
+@Composable
+private fun rememberBubbleImage(path: String): File? {
+    return remember(path) { path.takeIf { it.isNotBlank() }?.let { File(it) } }
+}
+
+/**
+ * 气泡里的图片层：垫在最底下铺满气泡，[tint] 打开时再压一层 [maskColor] 保证文字可读。
+ * 只能在 BoxScope 里调用，靠 matchParentSize 跟气泡走，不做任何模糊/缩放计算。
+ */
+@Composable
+private fun BoxScope.BubbleImageLayer(
+    image: File?,
+    maskColor: Color,
+    tint: Boolean,
+) {
+    if (image == null) return
+    AsyncImage(
+        model = image,
+        contentDescription = null,
+        contentScale = ContentScale.Crop,
+        modifier = Modifier.matchParentSize(),
+    )
+    // 遮罩 alpha 固定 0.72：不参与动画、不重建对象，同时保证气泡里的文字能看清
+    if (tint) {
+        Box(
+            modifier = Modifier
+                .matchParentSize()
+                .background(maskColor)
+        )
+    }
+}

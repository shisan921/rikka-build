+package me.rerere.rikkahub.ui.components.ui
+
+import kotlin.uuid.Uuid
+
+/**
+ * 一条「分组 + 条目」列表的拍平结果。
+ *
+ * 组只是条目上的一个 `folder` 字符串，没有独立的文件夹实体——
+ * 组里最后一条改走，这个组自然就消失了。
+ */
+data class FolderRow(
+    val key: String,
+    val folder: String,
+    /** 组头行才有：这一组有几条 */
+    val count: Int = 0,
+    /** 条目行才有：条目 id */
+    val entryId: Uuid? = null,
+) {
+    val isHeader: Boolean get() = entryId == null
+}
+
+/**
+ * 把平铺列表拍平成「组头行 + 组内条目行」。
+ *
+ * - 组的先后 = 组里第一条在列表里的位置（不按名字排）
+ * - **空名字（未分组）永远排最后**
+ * - 组内保持原有顺序
+ */
+fun <T> buildFolderRows(
+    items: List<T>,
+    folderOf: (T) -> String,
+    idOf: (T) -> Uuid,
+    isCollapsed: (String) -> Boolean,
+): List<FolderRow> {
+    val groups = LinkedHashMap<String, MutableList<T>>()
+    items.forEach { groups.getOrPut(folderOf(it)) { mutableListOf() }.add(it) }
+    val rows = ArrayList<FolderRow>(items.size + groups.size)
+    val orderedGroups = groups.entries.sortedBy { if (it.key.isBlank()) 1 else 0 }
+    orderedGroups.forEach { (folder, list) ->
+        rows += FolderRow(key = "header:$folder", folder = folder, count = list.size)
+        if (!isCollapsed(folder)) {
+            list.forEach { item ->
+                rows += FolderRow(
+                    key = "entry:${idOf(item)}",
+                    folder = folder,

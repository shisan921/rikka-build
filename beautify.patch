+/**
+ * 气泡配色：设置了自定义颜色就直接用它（自定义值自带 alpha，不再叠加 bubbleOpacity），
+ * 没设置时沿用原来的主题色 + 气泡透明度。最后再过一遍气泡自己的材质（SOLID = 原样）。
+ */
+@Composable
+private fun userBubbleContainer(setting: DisplaySetting): Color {
+    val custom = setting.userBubbleColor
+    val base = if (custom != null) {
+        Color(custom)
+    } else {
+        MaterialTheme.colorScheme.primaryContainer.copy(alpha = setting.bubbleOpacity)
+    }
+    return bubbleMaterialColor(setting, base)
+}
+
+@Composable
+private fun assistantBubbleContainer(setting: DisplaySetting): Color {
+    val custom = setting.assistantBubbleColor
+    val base = if (custom != null) {
+        Color(custom)
+    } else {
+        MaterialTheme.colorScheme.surfaceContainerHigh.copy(alpha = setting.bubbleOpacity)
+    }
+    return bubbleMaterialColor(setting, base)
+}
+
+/**
+ * 气泡底色按材质收一层：
+ *
+ * - SOLID：原样（实时模糊开着时仍然是原来那个 0.55 的软收缩，逐像素一致）；
+ * - TRANSLUCENT：不模糊，只把底色 alpha 压到 0.55，透出一点背景又还能读字；
+ * - FROSTED：底色常驻半透明，质感交给 haze（开关关掉时就是一张半透明底）；
+ * - LIQUID：真挂了 haze-glass 时底色交给 glass 自己上（透明），否则退回半透明底保证可读。
+ */
+private fun bubbleMaterialColor(setting: DisplaySetting, base: Color): Color {
+    // 实时模糊开着时给模糊留出可见度，与改动前完全一致
+    val withBlurRoom = if (setting.bubbleRealtimeBlur) {
+        base.copy(alpha = (base.alpha * 0.55f).coerceIn(0.05f, 1f))
+    } else {
+        base
+    }
+    val translucent = base.copy(alpha = (base.alpha * TRANSLUCENT_CONTAINER_ALPHA).coerceIn(0.05f, 1f))
+    return when (setting.bubbleSurfaceMaterial) {
+        SurfaceMaterial.SOLID -> withBlurRoom
+        SurfaceMaterial.TRANSLUCENT -> translucent
+        SurfaceMaterial.FROSTED -> translucent
+        SurfaceMaterial.LIQUID -> if (setting.bubbleRealtimeBlur) Color.Transparent else translucent
+    }
+}
+
+/**
+ * 气泡的材质装饰（性能护栏在这里）。
+ *
+ * - 半透明 / 纯色：不挂任何材质糊层（纯色沿用原来的实时模糊路径，见下）；
+ * - 「聊天气泡实时模糊」开关关掉时，气泡**一律**不做 haze 实时模糊，只留底色 / 半透明；
+ * - 开关打开才有 haze：SOLID 走原来的平地 hazeBlur（默认配置因此逐像素一致），
+ *   FROSTED / LIQUID 分别挂磨砂 / 液态玻璃。
+ * 另外 haze 源拿不到（不在聊天列表里）时也不挂，避免白算一遍。
+ */
+@Composable
+private fun bubbleMaterialModifier(
+    display: DisplaySetting,
+    hazeState: HazeState?,
+    shape: RoundedCornerShape,
+    tint: Color,
+): Modifier {
+    val material = display.bubbleSurfaceMaterial
+    // 半透明 = 只改底色，永远不模糊
+    if (material == SurfaceMaterial.TRANSLUCENT) return Modifier
+    if (!display.bubbleRealtimeBlur || hazeState == null) return Modifier
+    // 与原来的气泡模糊一样至少留 4dp，避免 0dp 时糊层等于没开还白算一遍
+    val blurDp = display.materialBlurDp().coerceAtLeast(4)
+    return when (material) {
+        SurfaceMaterial.SOLID -> Modifier.surfaceMaterialBlur(hazeState, blurDp)
+        SurfaceMaterial.TRANSLUCENT -> Modifier
+        SurfaceMaterial.FROSTED, SurfaceMaterial.LIQUID -> Modifier.surfaceMaterialEffect(
+            state = hazeState,
+            material = material,
+            blurDp = blurDp,
+            shape = shape,
+            tint = tint,
+        )
+    }
+}
+
+
+/**
+ * 思维链卡片的底色：跟 AI 气泡共用自定义色，透明度再乘上思维链自己的透明度。
+ */
+@Composable
+private fun reasoningContainer(setting: DisplaySetting): Color {
+    val base = setting.assistantBubbleColor?.let { Color(it) }
+        ?: MaterialTheme.colorScheme.surfaceContainerHigh
+    val alpha = (base.alpha * setting.bubbleOpacity * setting.reasoningAlpha).coerceIn(0f, 1f)
+    return base.copy(alpha = alpha)
+}
+
+/**
+ * 气泡圆角：bubbleCornerRadius >= 0 时用用户设定的值，-1 保持原来的 16dp 圆角。
+ */
+private fun bubbleShape(cornerRadius: Int): RoundedCornerShape {
+    return RoundedCornerShape(if (cornerRadius >= 0) cornerRadius.dp else 16.dp)
+}
+
+/**
+ * 气泡内容色：自定义底色不在主题色板里时 contentColorFor 会返回 Unspecified，
+ * 这时退回外层的内容色；用户明确设了正文文字色时以它为准。
+ */
+@Composable
+private fun bubbleContentColor(setting: DisplaySetting, containerColor: Color): Color {
+    val custom = setting.chatTextColor?.let { Color(it) }
+    val fromTheme = contentColorFor(containerColor)
+    val fallback = if (fromTheme == Color.Unspecified) LocalContentColor.current else fromTheme
+    return custom ?: fallback
+}

+fun snapshotDecorImages(context: Context, preset: DecorPreset): DecorPreset {
+    if (preset.id.isBlank()) return preset
+    val dir = File(context.filesDir, DECOR_IMAGE_DIR)
+
+    // [keepNonFile] = true 时，非文件路径（content:// 、https:// 这类外链）原样保留，
+    // 交给 Coil 自己去解析；否则视为失效，置空。助手背景图必须是 true——
+    // 它存的本来就是「本地文件 URI 或网络 URL」，不是 App 内部目录里的绝对路径。
+    fun target(slot: String): File = File(dir, "${preset.id}-$slot.jpg")

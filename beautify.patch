+/**
+ * 装扮卡片上那行小字：材质 / 字体 / 字号，让人一眼分得出这套是什么味道。
+ */
+fun decorPresetSummary(preset: DecorPreset): String {
+    val material = when (preset.surfaceMaterial) {
+        SurfaceMaterial.SOLID -> "纯色"
+        SurfaceMaterial.TRANSLUCENT -> "半透明"
+        SurfaceMaterial.FROSTED -> "磨砂"
+        SurfaceMaterial.LIQUID -> "液态"
+    }
+    val font = when (preset.chatFontFamily) {
+        ChatFontFamily.DEFAULT -> "默认体"
+        ChatFontFamily.SERIF -> "衬线体"
+        ChatFontFamily.MONOSPACE -> "等宽体"
+        ChatFontFamily.CUSTOM -> preset.chatCustomFontName.ifBlank { "自定义" }
+    }
+    val size = if (preset.chatFontSizePercent in 10..200) {
+        "${preset.chatFontSizePercent}%"
+    } else {
+        "${(preset.fontSizeRatio * 100).toInt()}%"
+    }
+    return "$material · $font · $size"
+}
+
+/**
+ * 判断这套装扮是不是「当前正在用的」。
+ *
+ * 做法是把它套回当前的 DisplaySetting 再比一次：字段全一样就等于正在用。
+ * 89 个字段的 equals，开销可以忽略，比另存一个「当前 id」更不容易出错
+ * （用户手改设置后也能立刻反映出来）。
+ */
+fun DecorPreset.matchesCurrent(current: Settings): Boolean {
+    // 只比真正会变的那几样，不构造新的 Settings ——
+    // 装扮面板横滑时每张卡都要算一次，applyToSettings 会复制整份 assistants 列表，那样太浪费
+    val assistant = current.assistants.firstOrNull { it.id == current.assistantId }
+    val displayMatches = applyTo(current.displaySetting) == current.displaySetting
+    val themeMatches = (themeId == null || themeId == current.themeId) &&
+        (dynamicColor == null || dynamicColor == current.dynamicColor)
+    val backgroundMatches = assistantBackgroundImage.isBlank() ||
+        assistantBackgroundImage == assistant?.background
+    return displayMatches && themeMatches && backgroundMatches
+}
+
+/**
+ * 装扮卡片：左边一块配色样板（主色 / 气泡色 / 输入框色叠在一起），右边名字 + 摘要。
+ *
+ * 用在两个地方：设置 · 装扮 的列表，和 + 面板点开后的横滑选择条。
+ */
+@Composable
+fun DecorPresetCard(
+    preset: DecorPreset,
+    currentSetting: Settings,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    compact: Boolean = false,
+) {
+    val selected = preset.matchesCurrent(currentSetting)
+    val seed = preset.themeSeedColor ?: preset.primaryColor
+    val bubble = preset.assistantBubbleColor ?: preset.userBubbleColor
+    val input = preset.inputBackgroundColor
+    val shape = RoundedCornerShape(16.dp)
+
+    Row(
+        modifier = modifier
+            .clip(shape)
+            .background(
+                if (selected) {
+                    MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.55f)
+                } else {
+                    MaterialTheme.colorScheme.surfaceContainerHighest.copy(alpha = 0.6f)
+                }
+            )
+            .border(
+                width = if (selected) 1.5.dp else 1.dp,
+                color = if (selected) {
+                    MaterialTheme.colorScheme.primary
+                } else {
+                    MaterialTheme.colorScheme.outlineVariant.copy(alpha = 0.6f)
+                },
+                shape = shape,
+            )
+            .clickable(onClick = onClick)
+            .padding(horizontal = 12.dp, vertical = if (compact) 10.dp else 12.dp),
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+        // 配色样板：三块小圆角色片叠着放，一眼看出主色 / 气泡色 / 输入框色
+        Box(
+            modifier = Modifier
+                .size(if (compact) 34.dp else 42.dp)
+                .clip(RoundedCornerShape(10.dp))
+                .background(seed?.let { Color(it) } ?: MaterialTheme.colorScheme.primary),
+        ) {
+            Box(
+                modifier = Modifier
+                    .align(Alignment.BottomEnd)
+                    .padding(4.dp)
+                    .size(if (compact) 12.dp else 16.dp)
+                    .clip(CircleShape)
+                    .background(bubble?.let { Color(it) } ?: MaterialTheme.colorScheme.secondary),
+            )
+            Box(
+                modifier = Modifier
+                    .align(Alignment.BottomStart)
+                    .padding(4.dp)
+                    .size(if (compact) 8.dp else 10.dp)
+                    .clip(CircleShape)
+                    .background(input?.let { Color(it) } ?: MaterialTheme.colorScheme.surface),
+            )
+        }
+
+        Column(
+            modifier = Modifier.weight(1f, fill = false),
+            verticalArrangement = Arrangement.spacedBy(2.dp),
+        ) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Text(
+                    text = preset.name.ifBlank { "未命名装扮" },
+                    style = MaterialTheme.typography.titleSmall,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                )
+                if (selected) {
+                    Text(
+                        text = " · 使用中",
+                        style = MaterialTheme.typography.labelSmall,
+                        color = MaterialTheme.colorScheme.primary,
+                    )
+                }
+            }
+            Text(
+                text = decorPresetSummary(preset),
+                style = MaterialTheme.typography.labelSmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+    }
+}
+
+/**
+ * + 面板里用的窄卡：竖着排，固定宽度，方便横滑。
+ */
+@Composable
+fun DecorPresetTile(
+    preset: DecorPreset,
+    currentSetting: Settings,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val selected = preset.matchesCurrent(currentSetting)
+    val seed = preset.themeSeedColor ?: preset.primaryColor
+    val bubble = preset.assistantBubbleColor ?: preset.userBubbleColor
+    val shape = RoundedCornerShape(16.dp)
+
+    Column(
+        modifier = modifier
+            .width(108.dp)
+            .clip(shape)
+            .background(
+                if (selected) {
+                    MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.55f)
+                } else {
+                    MaterialTheme.colorScheme.surfaceContainerHighest.copy(alpha = 0.6f)
+                }
+            )
+            .border(
+                width = if (selected) 1.5.dp else 1.dp,
+                color = if (selected) {
+                    MaterialTheme.colorScheme.primary
+                } else {
+                    MaterialTheme.colorScheme.outlineVariant.copy(alpha = 0.6f)
+                },
+                shape = shape,
+            )
+            .clickable(onClick = onClick)
+            .padding(8.dp),
+        verticalArrangement = Arrangement.spacedBy(6.dp),
+    ) {
+        // 上部色板：主色打底，右下角叠气泡色
+        Box(
+            modifier = Modifier
+                .fillMaxWidth()
+                .height(46.dp)
+                .clip(RoundedCornerShape(10.dp))
+                .background(seed?.let { Color(it) } ?: MaterialTheme.colorScheme.primary),
+        ) {
+            Box(
+                modifier = Modifier
+                    .align(Alignment.BottomEnd)
+                    .padding(4.dp)
+                    .size(14.dp)
+                    .clip(CircleShape)
+                    .background(bubble?.let { Color(it) } ?: MaterialTheme.colorScheme.secondary),
+            )
+            Box(
+                modifier = Modifier
+                    .align(Alignment.BottomStart)
+                    .padding(4.dp)
+                    .size(9.dp)
+                    .clip(CircleShape)
+                    .background(Color.White.copy(alpha = 0.75f)),
+            )
+        }
+        Text(
+            text = preset.name.ifBlank { "未命名" },
+            style = MaterialTheme.typography.labelMedium,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+        )
+        Text(
+            text = if (selected) "使用中" else decorPresetSummary(preset).substringBefore(" · "),
+            style = MaterialTheme.typography.labelSmall,
+            color = if (selected) {
+                MaterialTheme.colorScheme.primary
+            } else {
+                MaterialTheme.colorScheme.onSurfaceVariant
+            },
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+        )
+    }
+}

+/**
+ * 取色盘弹窗：色域方块 + 色相条 + 透明度条 + 原色/当前预览 + HEX 输入 + 记忆色。
+ *
+ * 全部自绘（Canvas + Brush + pointerInput），不依赖 `:ui` 模块里 `internal` 的 SketchColorPicker。
+ * 状态只在弹窗内部滚动，点「确认」才通过 [onConfirm] 写回设置；[onRecentColorsChange] 用于记忆色的
+ * 「+ / 长按删除」，是独立于颜色的设置项，可以立即落库，取消弹窗也不会把刚收藏的颜色弄丢。
+ *
+ * @param title 弹窗标题（即正在改的那一项的名字）
+ * @param initialColor 当前设置里的颜色（ARGB Long），null 表示还没设置
+ * @param fallbackColor 没设置时预览用的主题色
+ * @param recentColors 已保存的记忆色，最近的在前
+ * @param canReset 是否显示「恢复默认」（把颜色置回 null）
+ */
+@Composable
+fun ColorPickerDialog(
+    title: String,
+    initialColor: Long?,
+    fallbackColor: Color,
+    recentColors: List<Long>,
+    onRecentColorsChange: (List<Long>) -> Unit,
+    onDismiss: () -> Unit,
+    onConfirm: (Long) -> Unit,
+    canReset: Boolean = true,
+    onReset: () -> Unit = {},
+) {
+    // 色域里的初始值：设置过就用设置的颜色，没设置就落在主题色上，避免一进来是纯红
+    val baselineArgb: Long = (initialColor ?: (fallbackColor.toArgb().toLong() and 0xFFFFFFFFL)) and 0xFFFFFFFFL
+    val baselineColor = Color(baselineArgb)
+
+    val baselineHsv = remember(baselineArgb) {
+        FloatArray(3).also { AndroidColor.colorToHSV(baselineArgb.toInt(), it) }
+    }
+
+    var hue by remember(baselineArgb) { mutableStateOf(baselineHsv[0]) }
+    var saturation by remember(baselineArgb) { mutableStateOf(baselineHsv[1]) }
+    var brightness by remember(baselineArgb) { mutableStateOf(baselineHsv[2]) }
+    var alphaFraction by remember(baselineArgb) {
+        mutableStateOf(((baselineArgb shr 24) and 0xFFL) / 255f)
+    }
+    // null 表示「跟着色域走」，非 null 表示用户正在手打 HEX，先别覆盖他打的字
+    var hexDraft by remember(baselineArgb) { mutableStateOf<String?>(null) }
+
+    val currentArgb: Long = argbFromHsv(hue, saturation, brightness, alphaFraction)
+    val currentColor = Color(currentArgb)
+    val pureHueColor = Color(argbFromHsv(hue, 1f, 1f, 1f))
+
+    fun applyColorValue(value: Long) {
+        val normalized = value and 0xFFFFFFFFL
+        val hsv = FloatArray(3)
+        AndroidColor.colorToHSV(normalized.toInt(), hsv)
+        // 灰色/黑色没有色相，别把用户刚调好的色相拽回 0
+        if (hsv[1] > 0.0001f && hsv[2] > 0.0001f) hue = hsv[0]
+        saturation = hsv[1]
+        brightness = hsv[2]
+        alphaFraction = ((normalized shr 24) and 0xFFL) / 255f
+    }
+
+    fun applySquarePosition(x: Float, y: Float, width: Int, height: Int) {
+        if (width <= 0 || height <= 0) return
+        saturation = (x / width).coerceIn(0f, 1f)
+        brightness = 1f - (y / height).coerceIn(0f, 1f)
+    }
+
+    fun applyBarPosition(x: Float, width: Int): Float {
+        if (width <= 0) return 0f
+        return (x / width).coerceIn(0f, 1f)
+    }
+
+    // Brush 在组合里建，绘制 lambda 里不建集合
+    val squareHorizontalBrush = remember(pureHueColor) {
+        Brush.horizontalGradient(listOf(Color.White, pureHueColor))
+    }
+    val squareVerticalBrush = remember {
+        Brush.verticalGradient(listOf(Color.Transparent, Color.Black))
+    }
+    val hueBrush = remember {
+        Brush.horizontalGradient(
+            listOf(
+                Color.Red,
+                Color.Yellow,
+                Color.Green,
+                Color.Cyan,
+                Color.Blue,
+                Color.Magenta,
+                Color.Red,
+            )
+        )
+    }
+    val alphaBrush = remember(currentColor) {
+        Brush.horizontalGradient(
+            listOf(
+                currentColor.copy(alpha = 0f),
+                currentColor.copy(alpha = 1f),
+            )
+        )
+    }
+
+    val squareShape = RoundedCornerShape(12.dp)
+    val barShape = RoundedCornerShape(6.dp)
+
+    val draft = hexDraft
+    val hexText = draft ?: currentArgb.toHexArgb()
+    val hexParsed = if (draft != null) parseArgbHex(draft) else currentArgb
+    val hexError = draft != null && draft.isNotBlank() && parseArgbHex(draft) == null
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(title) },
+        text = {
+            Column(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .heightIn(max = 500.dp)
+                    .verticalScroll(rememberScrollState()),
+                verticalArrangement = Arrangement.spacedBy(10.dp),
+            ) {
+                // 1. 色域方块：横轴饱和度、纵轴明度
+                Box(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .height(240.dp)
+                        .clip(squareShape)
+                        .pointerInput(Unit) {
+                            detectTapGestures { offset ->
+                                applySquarePosition(offset.x, offset.y, size.width, size.height)
+                            }
+                        }

+
+/**
+ * 对白样式页：AI 回复里被 “引号” 包住的文字怎么画。
+ *
+ * 分组按用户要求从上到下依次是（每组一个独立的 [CardGroup]，互不混在一起）：
+ *
+ * ```
+ * ［引号高亮］ 引号内文字高亮      [开关]
+ * ［文字］     文字颜色            #676262 ●
+ * ［底色］     启用对白底色        [开关]
+ *              背景色              浅灰 ●
+ *              背景透明度          30%
+ *              底色圆角            4dp
+ *              行间空隙            2dp
+ * ［外层符号］ 外层符号            无 / 「」 / 『』  ← 三选一（分段按钮）
+ *              符号与内容间距      0         ← 滑块 -3~3：正数插薄空格、负数压紧
+ *              符号大小            1.00x    ← 滑块 0.7–1.5，只放大 / 缩小符号本身
+ *              符号跟随高亮色      [开关]   ← 默认开
+ * ［下划线］   实线                [开关]
+ *              颜色                红 ●     ← 只在「实线」打开时出现
+ *              虚线                [开关]
+ *              颜色                红 ●     ← 只在「虚线」打开时出现
+ *              点线                [开关]
+ *              颜色                红 ●     ← 只在「点线」打开时出现
+ *              下划线与文字的距离   2dp      ← 滑块 0–10dp
+ *              虚线与点线的密度     1.0x     ← 滑块 0.2–3.0，步进 0.1，越大越密
+ *              下划线左右内缩       0dp      ← 滑块 0–12dp，只收整段的两端（中间跨行行不受影响）
+ * ［行首竖线］ 行首竖线            [开关]
+ *              竖线颜色            红 ●     ← null 表示跟随文字颜色
+ *              竖线高度            0.7x     ← 滑块 0.3–1.2，按行高比例、行中心居中
+ *              竖线左右位置        0dp      ← 滑块 -8..4dp，x = 开引号左边缘 + 这个值
+ *              竖线粗细            2.00dp   ← 滑块 0.1–8dp 连续（0.01 一档），圆角仍 1dp
+ * ```
+ *
+ * 几条硬要求：
+ * - 「文字颜色」单独一组，和底色 / 下划线彻底分开；
+ * - 「底色」组里**没有**「下划线颜色」这一行（老版本里跑错组的那一项已经搬走）；
+ * - 下划线不再是「无 / 实线 / 虚线 / 点线」四选一，而是「实线」「虚线」「点线」三个独立开关，
+ *   各带自己的颜色；全打开就是三条线，依次往下错开 2dp（见 `QuoteHighlight.kt`）；
+ * - 颜色行只在对应开关打开时才显示，节省竖向空间；
+ * - 「外层符号」只是在渲染时往 `AnnotatedString` 里插字符（`「“你好。”」` / `『“你好。”』`），
+ *   消息原文一个字符都不改，复制 / 导出不受影响；符号**不进**引号区间，所以底色 / 下划线 /
+ *   行首竖线的几何完全不受影响，而且它和「行首竖线」是两个独立功能，可以同时打开；
+ *   三样都不选（`NONE` + 间距 0 + 大小 1.0x）时渲染与没有这个功能时逐像素一致。
+ *
+ * 所有字段都带默认值（开关全关、无底色、无下划线、竖线颜色跟随文字色），
+ * 默认状态下渲染结果与没有这个功能时逐像素一致。
+ */
+@Composable
+fun SettingPreferencesQuotePage(vm: SettingVM = koinViewModel()) {
+    val settings by vm.settings.collectAsStateWithLifecycle()
+    var displaySetting by remember(settings) { mutableStateOf(settings.displaySetting) }
+    // 只记「正在改哪一项」的 key，颜色值 / 更新函数每次都从当前组合里重新取，避免弹窗拿到过期的闭包
+    var colorTargetKey by remember { mutableStateOf<String?>(null) }
+
+    fun applyDisplaySetting(transform: (DisplaySetting) -> DisplaySetting) {
+        val next = transform(displaySetting)
+        displaySetting = next
+        vm.updateSettings(settings.copy(displaySetting = next))
+    }
+
+    val scrollBehavior = TopAppBarDefaults.exitUntilCollapsedScrollBehavior()
+    val backgroundAlpha = displaySetting.quoteHighlightBackgroundAlpha.coerceIn(0f, 1f)
+    val backgroundCorner = displaySetting.quoteBackgroundCorner.coerceIn(0, 24)
+    val backgroundGap = displaySetting.quoteBackgroundGap.coerceIn(0, 12)
+    // 下划线两条滑块：和文字的距离（dp）、虚线点线的密度（0.2–3.0，越大越密）
+    val underlineOffset = displaySetting.quoteUnderlineOffset.coerceIn(0, 10)
+    val dashScale = displaySetting.quoteDashScale.coerceIn(0.2f, 3.0f)
+    // 行首竖线三条滑块：高度（按行高比例 0.3–1.2）、左右位置（-8..4dp）、粗细（0.1–8dp 连续）
+    val barHeightScale = displaySetting.quoteBarHeightScale.coerceIn(0.3f, 1.2f)
+    val barOffsetDp = displaySetting.quoteBarOffsetDp.coerceIn(-8, 4)
+    val barWidthDp = displaySetting.quoteBarWidthDp.coerceIn(0.1f, 8f)
+    val underlineInsetDp = displaySetting.quoteUnderlineInsetDp.coerceIn(0, 12)
+    // 外层符号两条滑块：符号与内容之间的薄空格个数（0–3）、符号大小倍率（0.7–1.5）
+    val outerDecorSpace = displaySetting.quoteOuterDecorSpace.coerceIn(-3, 3)
+    val outerDecorScale = displaySetting.quoteOuterDecorScale.coerceIn(0.7f, 1.5f)
+
+    // ---- 颜色项：文字 / 底色 / 实线 / 虚线 / 点线 / 竖线，各管各的字段，互不串色 ----
+    val textColorField = ColorField(
+        key = "quoteText",
+        title = "文字颜色",
+        value = displaySetting.quoteHighlightColor,
+        preview = displaySetting.quoteHighlightColor?.let { Color(it) }
+            ?: MaterialTheme.colorScheme.onSurface,
+        supporting = { it?.toHexArgb() ?: "跟随正文色" },
+        apply = { setting, value -> setting.copy(quoteHighlightColor = value) },
+    )
+    val backgroundColorField = ColorField(
+        key = "quoteBackground",
+        title = "背景色",
+        value = displaySetting.quoteHighlightBackground,
+        preview = MaterialTheme.colorScheme.surfaceContainerHigh,
+        supporting = {
+            if (!displaySetting.quoteBackgroundEnabled) {
+                "未启用底色，先打开上面的「启用对白底色」"
+            } else {
+                it?.toHexArgb() ?: "还没选颜色，选了才会画底色"
+            }
+        },
+        apply = { setting, value -> setting.copy(quoteHighlightBackground = value) },
+    )
+    // 实线颜色：只在「实线」开关打开时才用得到，null = 跟随文字颜色
+    val solidColorField = ColorField(
+        key = "quoteUnderlineSolid",
+        title = "颜色",
+        value = displaySetting.quoteUnderlineSolidColor,
+        preview = displaySetting.quoteHighlightColor?.let { Color(it) }
+            ?: MaterialTheme.colorScheme.onSurface,
+        supporting = { it?.toHexArgb() ?: "跟随文字颜色" },
+        apply = { setting, value -> setting.copy(quoteUnderlineSolidColor = value) },
+    )
+    // 虚线颜色：只在「虚线」开关打开时才用得到，null = 跟随文字颜色
+    val dashedColorField = ColorField(
+        key = "quoteUnderlineDashed",
+        title = "颜色",
+        value = displaySetting.quoteUnderlineDashedColor,
+        preview = displaySetting.quoteHighlightColor?.let { Color(it) }
+            ?: MaterialTheme.colorScheme.onSurface,
+        supporting = { it?.toHexArgb() ?: "跟随文字颜色" },
+        apply = { setting, value -> setting.copy(quoteUnderlineDashedColor = value) },
+    )
+    // 点线颜色：只在「点线」开关打开时才用得到，null = 跟随文字颜色
+    val dottedColorField = ColorField(
+        key = "quoteUnderlineDotted",
+        title = "颜色",
+        value = displaySetting.quoteUnderlineDottedColor,
+        preview = displaySetting.quoteHighlightColor?.let { Color(it) }
+            ?: MaterialTheme.colorScheme.onSurface,
+        supporting = { it?.toHexArgb() ?: "跟随文字颜色" },
+        apply = { setting, value -> setting.copy(quoteUnderlineDottedColor = value) },
+    )
+    // 行首竖线颜色：null = 跟随文字颜色（不再借用下划线颜色）
+    val leadingBarColorField = ColorField(
+        key = "quoteLeadingBar",
+        title = "竖线颜色",
+        value = displaySetting.quoteLeadingBarColor,
+        preview = displaySetting.quoteHighlightColor?.let { Color(it) }
+            ?: MaterialTheme.colorScheme.onSurface,
+        supporting = { it?.toHexArgb() ?: "跟随文字颜色" },
+        apply = { setting, value -> setting.copy(quoteLeadingBarColor = value) },
+    )
+    val colorFields = listOf(
+        textColorField,
+        backgroundColorField,
+        solidColorField,
+        dashedColorField,
+        dottedColorField,
+        leadingBarColorField,
+    )
+
+    Scaffold(
+        topBar = {
+            LargeFlexibleTopAppBar(
+                title = { Text("对白样式") },
+                navigationIcon = {
+                    BackButton()
+                },
+                scrollBehavior = scrollBehavior,
+                colors = CustomColors.topBarColors
+            )
+        },
+        modifier = Modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+        containerColor = CustomColors.topBarColors.containerColor
+    ) { contentPadding ->
+        LazyColumn(
+            modifier = Modifier.fillMaxSize(),
+            contentPadding = contentPadding + PaddingValues(8.dp),
+            verticalArrangement = Arrangement.spacedBy(16.dp)
+        ) {
+            // ① 引号高亮总开关
+            item {
+                CardGroup(
+                    modifier = Modifier.padding(horizontal = 8.dp),
+                    title = { Text("引号高亮") },
+                ) {
+                    item(
+                        headlineContent = { Text("引号内文字高亮") },
+                        supportingContent = {
+                            Text("AI 回复里被 “引号” 包住的文字用下面的样式显示")
+                        },
+                        trailingContent = {
+                            Switch(
+                                checked = displaySetting.enableQuoteHighlight,
+                                onCheckedChange = { checked ->
+                                    applyDisplaySetting { it.copy(enableQuoteHighlight = checked) }
+                                },
+                            )
+                        },
+                    )
+                }
+            }
+            // ② 文字：只有一个文字颜色，单独一组（和底色 / 下划线彻底分开）
+            item {
+                CardGroup(
+                    modifier = Modifier.padding(horizontal = 8.dp),
+                    title = { Text("文字") },
+                ) {
+                    quoteColorItem(
+                        field = textColorField,
+                        onClick = { colorTargetKey = textColorField.key },
+                    )
+                }
+            }
+            // ③ 底色：开关 + 背景色 + 透明度 + 圆角 + 行间空隙（这里没有下划线颜色）
+            item {
+                CardGroup(
+                    modifier = Modifier.padding(horizontal = 8.dp),
+                    title = { Text("底色") },
+                ) {
+                    // 底色总开关：关掉就完全不画底色，不用点进取色盘「恢复默认」
+                    item(
+                        headlineContent = { Text("启用对白底色") },
+                        supportingContent = {
+                            Text("打开后才应用下面的背景色与透明度；关掉就完全不画底色")
+                        },
+                        trailingContent = {
+                            Switch(
+                                checked = displaySetting.quoteBackgroundEnabled,

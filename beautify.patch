+    // 主题基色：给一个颜色，用它生成整套浅色/深色配色（背景/卡片/文字/描边全部跟着推）
+    // AMOLED 纯黑仍要压在最上面，所以生成完再把深色背景拉回纯黑
+    val themeSeedColor = settings.displaySetting.themeSeedColor
+    val themeSchemeStyle = settings.displaySetting.themeSchemeStyle
+    val colorSchemeSeeded = remember(
+        colorSchemeConverted,
+        themeSeedColor,
+        themeSchemeStyle,
+        darkTheme,
+        amoledDarkMode,
+    ) {
+        if (themeSeedColor != null) {
+            val seeded = generateSchemeFromSeed(themeSeedColor, darkTheme, themeSchemeStyle)

+@Composable
+fun ChatMessageHeaderTime(
+    message: UIMessage,
+    modifier: Modifier = Modifier,
+) {
+    val settings = LocalSettings.current.displaySetting
+    if (!settings.showDateTimeInMessage || !settings.messageTimeUnderName) {
+        return
+    }
+    val timeText = remember(message.createdAt) {
+        message.createdAt.toJavaLocalDateTime().toMessageTimeFullString()
+    }
+    val timeColor = settings.messageTimeColor?.let { Color(it) }
+        ?: settings.chatTextColor?.let { Color(it) }
+        ?: MaterialTheme.colorScheme.onSurface
+    Text(
+        text = timeText,
+        style = MaterialTheme.typography.labelSmall,
+        color = timeColor,
+        maxLines = 1,
+        modifier = modifier,
+    )
+}

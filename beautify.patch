+package me.rerere.rikkahub.ui.theme
+
+import androidx.compose.foundation.BorderStroke
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.BoxScope
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.clip
+import androidx.compose.ui.graphics.Brush
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.Shape
+import androidx.compose.ui.unit.dp
+import dev.chrisbanes.haze.HazeInput
+import dev.chrisbanes.haze.HazeState
+import dev.chrisbanes.haze.blur.HazeBlurStyle
+import dev.chrisbanes.haze.blur.hazeBlur
+import dev.chrisbanes.haze.blur.material3.Material3
+import dev.chrisbanes.haze.glass.GlassDefaults
+import dev.chrisbanes.haze.glass.GlassStyle
+import dev.chrisbanes.haze.glass.OpticalSizeValue
+import dev.chrisbanes.haze.glass.hazeGlass
+import dev.chrisbanes.haze.glass.material3.Material3
+import me.rerere.rikkahub.data.datastore.DisplaySetting
+import me.rerere.rikkahub.data.datastore.SurfaceMaterial
+
+/**
+ * 界面材质（纯色 / 磨砂玻璃 / 液态玻璃）在非输入框界面上的复用实现。
+ *
+ * 只使用项目里 haze 2.0.0-rc02 已经在 ChatInput 用过的那些 API：
+ * HazeInput.Sources / HazeBlurStyle.Material3 / GlassStyle.Material3 / hazeBlur / hazeGlass。
+ * 一律不用 `Modifier.blur`，半径直接取设置里的 materialBlurRadius。
+ */
+
+/** 模糊强度统一收敛到 0..40，和设置页滑块的取值范围一致 */
+fun DisplaySetting.materialBlurDp(): Int = materialBlurRadius.coerceIn(0, 40)
+
+/** 是否真的需要走 haze：纯色就是原版外观，一点额外绘制都不加 */
+fun DisplaySetting.usesHazeSurfaceMaterial(): Boolean = surfaceMaterial != SurfaceMaterial.SOLID
+
+/**
+ * 给一个作用面加上材质效果。
+ *
+ * SOLID 原样返回（不做任何额外绘制）；FROSTED 用 haze 模糊；LIQUID 用 haze-glass
+ * （更强模糊 + glass 自带的光学高光），形状用传入的 [shape]。
+ */
+@Composable
+fun Modifier.surfaceMaterialEffect(
+    state: HazeState,
+    display: DisplaySetting,
+    shape: Shape,
+    tint: Color,
+): Modifier {
+    val radius = display.materialBlurDp()
+    return when (display.surfaceMaterial) {
+        SurfaceMaterial.SOLID -> this
+        SurfaceMaterial.FROSTED -> this.hazeBlur(
+            input = HazeInput.Sources(state),
+            style = HazeBlurStyle.Material3 {
+                blurRadius(radius.dp)
+            },
+        )
+
+        SurfaceMaterial.LIQUID -> this.hazeGlass(
+            input = HazeInput.Sources(state),
+            style = GlassStyle.Material3(
+                containerColor = tint,
+                tint = tint.copy(alpha = 0.72f),
+            ) {
+                optics(
+                    GlassDefaults.optics.copy(
+                        blurRadius = OpticalSizeValue.Fixed(radius.dp),
+                        depth = OpticalSizeValue.Fixed(0.5f),
+                    )
+                )
+                shape(shape as? RoundedCornerShape ?: RoundedCornerShape(0.dp))
+            },
+        )
+    }
+}
+
+/**
+ * 材质作用面自己的底色。
+ *
+ * 磨砂玻璃留一点半透明让背后模糊透出来；液态玻璃交给 haze-glass 自己上色，所以是透明。
+ */
+fun surfaceMaterialContainerColor(display: DisplaySetting, solid: Color, frosted: Color): Color =
+    when (display.surfaceMaterial) {
+        SurfaceMaterial.SOLID -> solid
+        SurfaceMaterial.FROSTED -> frosted.copy(alpha = 0.55f)
+        SurfaceMaterial.LIQUID -> Color.Transparent
+    }
+
+/**
+ * 液态玻璃的边缘高光：1dp 半透明白描边。其它材质沿用调用方原来的 [fallback] 描边。
+ */
+fun surfaceMaterialBorder(display: DisplaySetting, fallback: BorderStroke?): BorderStroke? =
+    when (display.surfaceMaterial) {
+        SurfaceMaterial.LIQUID -> BorderStroke(1.dp, Color.White.copy(alpha = 0.35f))
+        else -> fallback
+    }
+
+/**
+ * 液态玻璃的轻微渐变高光，垫在内容上面一层。
+ *
+ * 渐变对象用 remember 缓存，不逐帧新建；本身不消费触摸事件，不影响点击。
+ */
+@Composable
+fun BoxScope.LiquidGlassHighlight(shape: Shape) {
+    val brush = remember {
+        Brush.verticalGradient(
+            listOf(
+                Color.White.copy(alpha = 0.14f),
+                Color.Transparent,
+                Color.White.copy(alpha = 0.04f),
+            )
+        )
+    }
+    Box(
+        modifier = Modifier
+            .matchParentSize()
+            .clip(shape)
+            .background(brush)
+    )
+}

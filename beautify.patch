+                            detectDragGestures(
+                                onDragStart = { offset ->
+                                    hue = applyBarPosition(offset.x, size.width) * 360f
+                                },
+                                onDrag = { change, _ ->
+                                    change.consume()
+                                    hue = applyBarPosition(change.position.x, size.width) * 360f
+                                },
+                            )
+                        },
+                ) {
+                    Canvas(modifier = Modifier.fillMaxSize()) {
+                        drawRect(brush = hueBrush)
+                        val centerX = (hue.coerceIn(0f, 360f) / 360f) * size.width
+                        drawCircle(
+                            color = Color.Black.copy(alpha = 0.3f),
+                            radius = 8.dp.toPx(),
+                            center = Offset(centerX, size.height / 2f),
+                            style = Stroke(width = 3.dp.toPx()),
+                        )
+                        drawCircle(
+                            color = Color.White,
+                            radius = 7.dp.toPx(),
+                            center = Offset(centerX, size.height / 2f),
+                            style = Stroke(width = 2.dp.toPx()),
+                        )
+                    }
+                }
+
+                // 3. 透明度条：底下一层棋盘格，上面叠 alpha 渐变
+                Box(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .height(14.dp)
+                        .clip(barShape)
+                        .pointerInput(Unit) {
+                            detectTapGestures { offset ->
+                                alphaFraction = applyBarPosition(offset.x, size.width)
+                            }
+                        }
+                        .pointerInput(Unit) {
+                            detectDragGestures(
+                                onDragStart = { offset ->
+                                    alphaFraction = applyBarPosition(offset.x, size.width)
+                                },
+                                onDrag = { change, _ ->
+                                    change.consume()
+                                    alphaFraction = applyBarPosition(change.position.x, size.width)
+                                },
+                            )
+                        },
+                ) {
+                    Canvas(modifier = Modifier.fillMaxSize()) {
+                        val cell = 8.dp.toPx()
+                        val columns = ceil(size.width / cell).toInt()
+                        val rows = ceil(size.height / cell).toInt()
+                        val cellSize = Size(cell, cell)
+                        for (row in 0 until rows) {
+                            for (column in 0 until columns) {
+                                val light = (row + column) % 2 == 0
+                                drawRect(
+                                    color = if (light) Color(0xFFEFEFEF) else Color(0xFFBFBFBF),
+                                    topLeft = Offset(column * cell, row * cell),
+                                    size = cellSize,
+                                )
+                            }
+                        }
+                        drawRect(brush = alphaBrush)
+                        val centerX = alphaFraction.coerceIn(0f, 1f) * size.width
+                        drawCircle(
+                            color = Color.Black.copy(alpha = 0.35f),
+                            radius = 8.dp.toPx(),
+                            center = Offset(centerX, size.height / 2f),
+                            style = Stroke(width = 3.dp.toPx()),
+                        )
+                        drawCircle(
+                            color = Color.White,
+                            radius = 7.dp.toPx(),
+                            center = Offset(centerX, size.height / 2f),
+                            style = Stroke(width = 2.dp.toPx()),
+                        )
+                    }
+                }
+
+                // 4. 预览行：原色 → 当前
+                Row(
+                    modifier = Modifier.fillMaxWidth(),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(16.dp),
+                ) {
+                    ColorPreview(label = "原色", color = baselineColor, size = 40.dp)
+                    Text(
+                        text = "→",
+                        style = MaterialTheme.typography.titleMedium,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                    ColorPreview(label = "当前", color = currentColor, size = 40.dp)
+                }
+
+                // 5. HEX 输入：手打立刻同步回色域，失焦后显示规范化后的值
+                OutlinedTextField(
+                    value = hexText,
+                    onValueChange = { input ->
+                        hexDraft = input
+                        parseArgbHex(input)?.let { applyColorValue(it) }
+                    },
+                    singleLine = true,
+                    isError = hexError,
+                    label = { Text("颜色值") },
+                    placeholder = { Text("#AARRGGBB") },
+                    supportingText = {
+                        Text(
+                            if (hexError) {
+                                "格式不对，用 #RRGGBB 或 #AARRGGBB"
+                            } else {
+                                "A 是透明度，FF 为不透明"
+                            }
+                        )
+                    },
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .onFocusChanged { state -> if (!state.isFocused) hexDraft = null },
+                )
+
+                // 6. 记忆色
+                Row(
+                    modifier = Modifier.fillMaxWidth(),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    Text(
+                        text = "记忆色",
+                        style = MaterialTheme.typography.labelLarge,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                    Row(
+                        modifier = Modifier
+                            .weight(1f)
+                            .horizontalScroll(rememberScrollState()),
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.spacedBy(8.dp),
+                    ) {
+                        recentColors.forEach { value ->
+                            Box(
+                                modifier = Modifier
+                                    .size(28.dp)
+                                    .clip(CircleShape)
+                                    .background(Color(value))
+                                    .border(
+                                        width = 1.dp,
+                                        color = MaterialTheme.colorScheme.outlineVariant,
+                                        shape = CircleShape,
+                                    )
+                                    .pointerInput(value) {
+                                        detectTapGestures(
+                                            onTap = {
+                                                applyColorValue(value)
+                                                hexDraft = null
+                                            },
+                                            onLongPress = {
+                                                onRecentColorsChange(recentColors - value)
+                                            },
+                                        )
+                                    },
+                            )
+                        }
+                        Box(
+                            modifier = Modifier
+                                .size(28.dp)
+                                .clip(CircleShape)
+                                .border(
+                                    width = 1.dp,
+                                    color = MaterialTheme.colorScheme.outline,
+                                    shape = CircleShape,
+                                )
+                                .clickable {
+                                    onRecentColorsChange(pushRecentColor(recentColors, currentArgb))
+                                },
+                            contentAlignment = Alignment.Center,
+                        ) {
+                            Text(
+                                text = "+",
+                                style = MaterialTheme.typography.titleMedium,
+                                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                            )
+                        }
+                    }
+                }
+                Text(
+                    text = "点一下取用，长按删除；最多记 12 个",
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    modifier = Modifier.padding(top = 2.dp),
+                )
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = { onConfirm(hexParsed ?: currentArgb) }) {
+                Text("确认")
+            }
+        },
+        dismissButton = {
+            Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                if (canReset) {
+                    TextButton(onClick = onReset) {
+                        Text("恢复默认")
+                    }
+                }
+                TextButton(onClick = onDismiss) {
+                    Text("取消")
+                }
+            }
+        },
+    )
+}
+
+/** 圆形预览色块 + 底下的小标签 */
+@Composable
+private fun ColorPreview(
+    label: String,
+    color: Color,
+    size: androidx.compose.ui.unit.Dp,
+) {
+    Column(horizontalAlignment = Alignment.CenterHorizontally) {
+        Box(
+            modifier = Modifier
+                .size(size)
+                .clip(CircleShape)
+                .background(color)
+                .border(
+                    width = 1.dp,
+                    color = MaterialTheme.colorScheme.outlineVariant,
+                    shape = CircleShape,
+                ),
+        )
+        Text(
+            text = label,
+            style = MaterialTheme.typography.labelSmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(top = 4.dp),
+        )
+    }
+}
+
+/** 记忆色上限 */
+internal const val MAX_RECENT_COLORS = 12
+
+/**
+ * 把 [color] 放到记忆色最前面：去重（同色只留最前面那个）、最多 [MAX_RECENT_COLORS] 个。
+ * 颜色统一按 32 位 ARGB 归一化，避免 `toArgb()` 出来的负数 Int 和正数 Long 被当成两个颜色。
+ */
+internal fun pushRecentColor(recentColors: List<Long>, color: Long): List<Long> {
+    val normalized = color and 0xFFFFFFFFL
+    val result = ArrayList<Long>(MAX_RECENT_COLORS)
+    result.add(normalized)
+    for (item in recentColors) {
+        if (result.size >= MAX_RECENT_COLORS) break
+        val value = item and 0xFFFFFFFFL
+        if (value != normalized) {
+            result.add(value)
+        }
+    }
+    return result
+}
+
+/** HSV + alpha → 0xAARRGGBB */
+internal fun argbFromHsv(hue: Float, saturation: Float, brightness: Float, alpha: Float): Long {
+    val alphaInt = (alpha.coerceIn(0f, 1f) * 255f).roundToInt().coerceIn(0, 255).toLong()
+    val normalizedHue = ((hue % 360f) + 360f) % 360f
+    val rgb = AndroidColor.HSVToColor(
+        floatArrayOf(
+            normalizedHue,
+            saturation.coerceIn(0f, 1f),
+            brightness.coerceIn(0f, 1f),
+        )
+    ).toLong() and 0xFFFFFFL
+    return (alphaInt shl 24) or rgb
+}

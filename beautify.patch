+/**
+ * 一项可自定义的颜色。[value] 为 null 表示还没设置，[preview] 是没设置时取色盘 / 色块示意用的主题色。
+ *
+ * [apply] 是纯函数：拿当前 [DisplaySetting] 和新颜色算出新设置，这样确认时永远基于最新状态改，
+ * 不会因为弹窗开着期间设置变过而把别的字段（比如记忆色）覆盖回去。
+ */
+private class ColorField(
+    val key: String,
+    val title: String,
+    val value: Long?,
+    val preview: Color,
+    val supporting: (Long?) -> String,
+    val apply: (DisplaySetting, Long?) -> DisplaySetting,
+)
+
+/**
+ * 解析 `#RRGGBB` / `#AARRGGBB`：兼容不带 `#`、`0x` 前缀，3/4 位的简写会按 ARGB 每位重复一次展开。
+ * 解析不出来返回 null，调用方保持原来的值。
+ */
+internal fun parseArgbHex(input: String): Long? {
+    val raw = input.trim()
+        .removePrefix("#")
+        .removePrefix("0x")
+        .removePrefix("0X")
+    if (raw.isEmpty()) return null
+    val hex = when (raw.length) {
+        // 简写每位重复一次：#F80 -> #FF8800
+        3 -> "FF" + raw.map { "$it$it" }.joinToString("")
+        4 -> raw.map { "$it$it" }.joinToString("")
+        6 -> "FF$raw"
+        8 -> raw
+        else -> return null
+    }
+    if (hex.any { it.digitToIntOrNull(16) == null }) return null
+    return hex.toLongOrNull(16)
+}
+
+/** 把 ARGB 拼成 `#AARRGGBB`；alpha 是 FF 时只显示 `#RRGGBB`，方便手动改。 */
+internal fun Long.toHexArgb(): String {
+    val alpha = (this shr 24) and 0xFFL
+    return if (alpha == 0xFFL) {
+        "#%06X".format(Locale.US, this and 0xFFFFFFL)
+    } else {
+        "#%08X".format(Locale.US, this)
+    }
+}

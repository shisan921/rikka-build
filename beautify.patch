+        titleSmallEmphasized = base.titleSmallEmphasized.scaledBy(),
+        bodyLargeEmphasized = base.bodyLargeEmphasized.scaledBy(),
+        bodyMediumEmphasized = base.bodyMediumEmphasized.scaledBy(),
+        bodySmallEmphasized = base.bodySmallEmphasized.scaledBy(),
+        labelLargeEmphasized = base.labelLargeEmphasized.scaledBy(),
+        labelMediumEmphasized = base.labelMediumEmphasized.scaledBy(),
+        labelSmallEmphasized = base.labelSmallEmphasized.scaledBy(),
